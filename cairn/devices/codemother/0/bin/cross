#!/usr/bin/env bash
# cairn codemother cross — the ticket asks CodeMother's clearance gate to queue it (cross <ticket>)
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"

    # A THIN mouth (outline 3.3.4.3, 9.7; ticket 0be964512fb0): it instantiates the ticket and
    # has it queue itself at clearance, fileref only. The gate derives the target and the
    # proofs from the ticket; every judgement is the gate's, none is this file's.
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
args = sys.argv[1:]
timeout = 240.0
if '--timeout' in args:
    i = args.index('--timeout')
    timeout = float(args[i + 1])
    del args[i:i + 2]
if len(args) != 1 or args[0].startswith('-'):
    print('usage: cairn codemother cross <ticket> [--timeout <s>]  (the gate derives the target and the proofs)')
    sys.exit(1)
from cairn.tools.bus_client import reach
from cairn.machines.ticket.ticket import Ticket
from cairn.devices.codemother.machines.watchme.gate import Voice
bus = reach('codemother')
ticket = Ticket.at(args[0])
out = ticket.queueme('clearance', participant=Voice(bus, sender='cairn-codemother-cli'), timeout=timeout)
print(json.dumps(out, indent=2, default=str))
sys.exit(0 if out.get('queued') else 1)
" "$@"
