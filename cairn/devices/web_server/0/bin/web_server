#!/usr/bin/env bash
# cairn web_server [verb] [args...] — the root verbs (list show get stop start settings, and the
# `hot` modifier) resolve in the shim base, one resolver for every device (ticket b41b0c0fff0e).
# This folder is also what declares instance 0 (outline 5.7.3.4): the ground loop's pulse
# (groundloop/pulse.py) starts the shim that holds the port for it (ticket 0482542c2b7c).
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"
exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.web_server.shim import WebServerShim
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(WebServerShim, sys.argv[1:]))
" "$@"
