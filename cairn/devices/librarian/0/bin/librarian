#!/usr/bin/env bash
# cairn librarian — wake the librarian and open its chat in the browser.
#
# A bare call goes through the librarian's shim (ticket d832a24e5144; Q#30, Akien 2026-11-06):
# the shim parses the request (nothing), wakes the librarian, and this terminal's process opens
# the browser at its chat page on the one web server, whose own shim starts the web server.
# Each part is self-initializing. No URL is printed. The browser is skipped when stdout is not a
# terminal or CAIRN_LIBRARIAN_NO_BROWSER is set.
#
#   cairn librarian               wake it and open its chat
#   cairn librarian show status   the root verbs, through the shim
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"

# --- the root verbs (ticket b41b0c0fff0e) ------------------------------------
# A first token that folds to one of the six root verbs (cairn.tools.base.shim.ROOT_VERBS)
# resolves in the shim base: `cairn librarian show status hot` wakes a LibrarianDevice in
# the bus process and reads it live. A bare call wakes it and opens its chat (below).
case "${1:-}" in
  [Ll][Ii][Ss][Tt]|[Ss][Hh][Oo][Ww]|[Gg][Ee][Tt]|[Ss][Tt][Oo][Pp]|[Ss][Tt][Aa][Rr][Tt]|[Ss][Ee][Tt][Tt][Ii][Nn][Gg][Ss])
    export PATH="${CAIRN_VENV:-$HOME/.cairn/venv}/bin:$PATH"
    exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.librarian.shim import LibrarianShim
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(LibrarianShim, sys.argv[1:]))
" "$@"
    ;;
esac

export PATH="${CAIRN_VENV:-$HOME/.cairn/venv}/bin:$PATH"
# Anything else the shim answers (a word it does not know is refused there, loud), so only a
# bare call opens the browser.
exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.librarian.shim import LibrarianShim, open_chat
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(LibrarianShim, sys.argv[1:]) if sys.argv[1:] else open_chat())
" "$@"
