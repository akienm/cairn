#!/usr/bin/env bash
# The trouble lane's operator surface. It is trouble's OWN code, so it reads the store as files
# through the tool trouble publishes (tools/store/) and folds in its own process — it never
# asks trouble over the bus (ticket ee04bb869795; Akien 2026-10-18: "TROUBLE TICKETS ARE A
# FILE ARTIFACT IN THE LOGGING TREE" / "THERE SHOULD BE NO ROWS FOR TROUBLE TICKETS").
#
# TEXT HERE, JSON FOR MACHINES (memory: inter-device-queries-via-bus-verbs). A person at a
# terminal reads sentences; `--json` hands back the rows untouched, so a script never has to
# parse prose.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"

subcmd="${1:-}"; subcmd="${subcmd,,}"   # a subcommand is a system word (ruled 2026-09-07)
shift 2>/dev/null || true

case "$subcmd" in
  live)
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.trouble.shim import TroubleShim
from cairn.devices.trouble.tools.store import store

as_json = '--json' in sys.argv[1:]
# The owner folds what is pending before the read answers, in this process (as drain does).
TroubleShim().drain()
try:
    troubles = store.live()
except FileNotFoundError as exc:
    # NOT an empty list. 'there is no store' and 'nothing is wrong' are the two readings a
    # silent green confuses, and they are opposites (Law 7).
    print(f'trouble store unreadable: {exc}', file=sys.stderr)
    sys.exit(1)
if as_json:
    print(json.dumps(troubles, indent=2))
    sys.exit(0)
if not troubles:
    print('no live troubles.')
    sys.exit(0)
whole = {t.get('id'): t for t in store.listing(store.store_root())}
print(f'{len(troubles)} live trouble(s):')
for t in troubles:
    print()
    print(f\"  [{t.get('count', '?')}x] {t.get('id', '?')}   ({t.get('standing', '?')})\")
    print(f\"        {t.get('why', '')}\")
    print(f\"        first {t.get('first_seen', '?')}  last {t.get('last_seen', '?')}\")
    w = whole.get(t.get('id')) or {}
    done = {c.get('by') for c in w.get('cleared_by') or [] if isinstance(c, dict)}
    told = [r for r in w.get('notified') or [] if r not in done]
    if told:
        print(f\"        awaiting clear from: {', '.join(told)}\")
" "$@"
    ;;
  clear)
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')

args = sys.argv[1:]
identity = args[0] if args and not args[0].startswith('--') else ''

def opt(name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else ''

by = opt('--by') or 'cc'
what_changed = opt('--what-changed')
if not identity or not what_changed:
    print('usage: cairn trouble clear <identity> [--by <who>] --what-changed <what>',
          file=sys.stderr)
    # WHAT-CHANGED IS NOT OPTIONAL, here or at the door. A clear with no change behind it is
    # the silent failure this lane exists to remove; refusing it at the CLI costs the
    # operator one retry instead of costing the record its meaning.
    sys.exit(1)

# THE CLEAR IS AN EMISSION FOLDED IN THIS PROCESS (ticket ee04bb869795). clear_trouble measures
# the hand here, in the clearer's own process (c2172127d7a4, 63e6eb836769), and the emission
# lands in logs/cli/0 — a home the drain reads (it skips only trouble's own). The drain is the
# owner's code deciding the clear, so declining stays the owner's judgment (Law 6).
import time
from cairn.devices.trouble.shim import TroubleShim
from cairn.devices.trouble.tools.store import store
from cairn.tools.base.diagnostic import ModuleRaiser
shim = TroubleShim()
ModuleRaiser('cli').clear_trouble(identity, by=by, what_changed=what_changed)
def mine(rows):
    return [f for f in rows or [] if str(f.get('emission', '')).startswith('cli/')
            and str(f.get('emission', '')).endswith('.clear_trouble.json')]
outcome = None
for _ in range(50):
    report = shim.drain()
    wanted = shim._device.identity_of(identity)
    hits = [f for f in mine(report.get('folded')) if f.get('id') == wanted] + mine(report.get('refused'))
    if hits:
        outcome = hits[-1]
        break
    if report.get('outcome') != 'reentrant':
        break
    time.sleep(0.1)  # another process holds the fold lock and is folding; ask again
if outcome is None:
    print(f'{identity}: not folded here — the emission stands in logs/cli/0 for the next drain',
          file=sys.stderr)
    sys.exit(1)
if 'error' in outcome or outcome.get('outcome') == 'declined':
    print(f\"{identity}: {outcome.get('outcome') or 'refused'} — {outcome.get('why') or outcome.get('error', '')}\",
          file=sys.stderr)
    sys.exit(1)
root = store.store_root()
path = root / f'{wanted}.json'
if not path.is_file():
    path = root / store.CLEARED_DIR / f'{wanted}.json'
body = json.loads(path.read_text(encoding='utf-8'))
if '--json' in args:
    print(json.dumps(body, indent=2))
else:
    print(f\"{identity}: cleared by {by} — now {body.get('standing', '?')}\")
    done = {c.get('by') for c in body.get('cleared_by') or [] if isinstance(c, dict)}
    still = [r for r in body.get('notified') or [] if r not in done]
    if still and body.get('standing') != 'CLEARED':
        print(f\"still awaiting clear from: {', '.join(still)}\")
" "$@"
    ;;
  drain)
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
from cairn.tools.bus_client import reach
# reach() pulses the shim, and the shim drains on pulse — so this has already happened by
# the time the bus comes back. The subcommand exists so an operator can MAKE it happen
# without waiting for a beat, and see what the fold did.
# Measured 2026-09-15: the pulse folded 461 emissions and this printed '0 folded', because
# the count came from the SECOND drain, after the pulse had already advanced the
# watermarks. So the report is pending-before minus pending-after — what the sweep as a
# whole folded, whichever process did the folding (Law 7: the count is the lane's value).
from cairn.devices.trouble.shim import TroubleShim, GATES
def pending(shim):
    marks = shim._load_watermarks(); out = {}
    for src in shim._source_dirs():
        key = f'{src.parent.name}/{src.name}'
        for gate in GATES:
            wm = marks.get(key if gate == 'raise_trouble' else f'{key}::{gate}', '')
            if not isinstance(wm, str): wm = ''
            n = sum(1 for q in src.glob(f'*.{gate}.json') if q.name > wm)
            if n: out[f'{key}:{gate}'] = n
    return out
shim = TroubleShim()
before = pending(shim)
reach('trouble')
report = shim.drain()
after = pending(shim)
report['pending_before'] = before
report['pending_after'] = after
report['folded_count'] = sum(before.values()) - sum(after.values())
print(json.dumps(report, indent=2))
" "$@"
    ;;
  *)
    # A non-empty line that is not live/clear/drain is a root verb (list show get stop start
    # settings, `hot` modifier) and resolves in the shim base (ticket b41b0c0fff0e); only the
    # bare `cairn trouble` prints this help.
    if [ -n "$subcmd" ]; then
      exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.trouble.shim import TroubleShim
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(TroubleShim, sys.argv[1:]))
" "$subcmd" "$@"
    fi
    exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.trouble.shim import TroubleShim
shim = TroubleShim()
print(f'device: {shim.device_id}')
print(f'class:  cairn/devices/trouble/')
print()
print('commands:')
print('  cairn trouble live [--json]                    — what is still demanding attention')
print('  cairn trouble clear <id> --what-changed <what> [--by <who>]')
print('                                                 — the recipient says it was fixed')
print('  cairn trouble drain                            — fold pending raises now, dont wait')
print()
print('there is no raise subcommand, and the absence is the design: raising needs no')
print('addressee and no running lane, so any component does it directly through')
print('DiagnosticBase.raise_trouble. Holding is what needs an owner.')
" "$@"
    ;;
esac
