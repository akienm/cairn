#!/usr/bin/env bash
# cairn — the single entry point into the system.
#
#   cairn <device>[.<instance>] [verb] [args...]
#
# Resolves through the FILESYSTEM — no registry, no config (Law 4: physics, not policy).
# The dispatch:
#
#   cairn librarian              →  ~/.cairn/devices/librarian/0/bin/librarian
#   cairn librarian learn "X"    →  ~/.cairn/devices/librarian/0/bin/learn "X"
#   cairn superclaude            →  ~/.cairn/devices/superclaude/0/bin/superclaude
#   cairn akien show myissues    →  ~/.cairn/devices/akien/0/bin/show myissues
#   cairn cc.1 restart           →  ~/.cairn/devices/cc/1/bin/restart
#
# THE INSTANCE IS PART OF THE ADDRESS, and it is written with a dot (Akien, 2026-09-22:
# "wouldn't it be `cairn cc.x restart`?" — ticket 55fc9263bf5a). The segment was never
# optional in the roots (`devices/<device>/<instance>/` in both, and a singleton is
# instance 0, not an exemption — CLAUDE.md); until this landed the dispatcher was the one
# place that could not say it, with the 0 hard-coded. A bare `cairn <device>` still
# resolves to instance 0 — by DEFAULT, not by a second code path: the default is set once,
# before the split, and the split overwrites it when a dot is there to overwrite it with.
#
# The instance-space bin/ is (usually) a symlink to class-space:
#   ~/.cairn/devices/<dev>/<instance>/bin  →  ~/dev/src/cairn/cairn/devices/<dev>/0/bin
# so the code lives once in git and customization is "unlink, copy, have fun." Class-space
# has ONE bin per device, not one per instance: instance 1 links the same scripts.
#
# VERB DEFAULTS TO DEVICE NAME: `cairn librarian` is shorthand for `cairn librarian librarian`
# — the self-named launcher script. Every device with a bin/ has one.
#
# TRANSITION: old-style flat verbs (`cairn test`, `cairn ruling`) still resolve through
# bin/cmd/ if no device matches. This fallback shrinks monotonically as verbs find their
# device homes.
set -euo pipefail

INSTANCE_ROOT="${CAIRN_INSTANCE_ROOT:-$HOME/.cairn/devices}"

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LEGACY_CMD_DIR="${CAIRN_CMD_DIR:-$HERE/cmd}"

_usage() {
  echo "cairn: usage: cairn <device> [verb] [args...]" >&2
  echo "" >&2
  echo "devices:" >&2
  local found=0 d
  for d in "$INSTANCE_ROOT"/*/0/bin; do
    if [ -d "$d" ]; then
      echo "  $(basename "$(dirname "$(dirname "$d")")")" >&2
      found=1
    fi
  done
  [ "$found" -eq 0 ] && echo "  (none wired yet)" >&2
  # show legacy verbs if any remain
  local legacy=0 f
  for f in "$LEGACY_CMD_DIR"/*; do
    if [ -f "$f" ] && [ -x "$f" ]; then
      if [ "$legacy" -eq 0 ]; then
        echo "" >&2
        echo "legacy verbs (transitional — moving into devices):" >&2
        legacy=1
      fi
      echo "  $(basename "$f")" >&2
    fi
  done
  return 0
}

if [ $# -eq 0 ]; then
  # No arguments: launch the librarian. If instance-space isn't wired yet, bootstrap first.
  device_bin="$INSTANCE_ROOT/librarian/0/bin"
  if [ -x "$device_bin/librarian" ]; then
    exec "$device_bin/librarian"
  fi
  # Not wired — try the bootstrap, which wires everything up
  bootstrap="$HERE/../launchers/bootstrap_first_run.sh"
  if [ -x "$bootstrap" ]; then
    exec "$bootstrap"
  fi
  echo "cairn: librarian not wired and no bootstrap found." >&2
  echo "  expected: $device_bin/librarian" >&2
  echo "  or: $bootstrap" >&2
  _usage
  exit 2
fi

# ── the floor (ticket 0853294fe972) ──────────────────────────────────────────
# "the cairn command sees that the venv exists, and the db, and that it's all set up"
# (Akien, 2026-09-06, CairnCommons/intentions-not-beside-code/I-the-command-lazy-inits-the-system.md).
# THE HAPPY PATH IS THREE BUILTIN TESTS AND NOTHING ELSE — no subprocess, no python, no
# cache (baseline 4.3ms median to exec, measured 2026-09-16; the budget is <10ms added).
# A miss pays the heavy path once: the lay-down is LIFTED, never copied — the venv is
# launchers/bootstrap.sh's (verify then apply), the wiring is bootstrap.sh's
# cairn_wire_instances, the db start is one sudo -n call and the only place it is made.
# A floor that cannot be laid is refused loud, with the check named, exit 3 — the resolver
# is never reached on a floor that is not there (Law 7; gates are physics).
CAIRN_VENV="${CAIRN_VENV:-$HOME/.cairn/venv}"
CAIRN_PG_SOCKET_DIR="${CAIRN_PG_SOCKET_DIR:-/var/run/postgresql}"

_floor_refuse() {  # <check> <what was probed, what came back, the one remedy>
  echo "cairn: floor: $1 — $2" >&2
  exit 3
}

_floor_venv() {
  [[ -x "$CAIRN_VENV/bin/python3" ]] && return 0
  # shellcheck source=/dev/null
  source "$HERE/../launchers/bootstrap.sh" 2>/dev/null || _floor_refuse venv \
    "$CAIRN_VENV/bin/python3 is absent and $HERE/../launchers/bootstrap.sh (the venv's one recipe) did not load"
  declare -F cairn_bootstrap_apply >/dev/null 2>&1 || _floor_refuse venv \
    "$CAIRN_VENV/bin/python3 is absent and bootstrap.sh exposes no cairn_bootstrap_apply"
  cairn_bootstrap_verify >/dev/null 2>&1 || cairn_bootstrap_apply >/dev/null 2>&1 || true
  cairn_bootstrap_verify >/dev/null 2>&1 && return 0
  _floor_refuse venv "$CAIRN_VENV/bin/python3 was absent and the lay-down (launchers/bootstrap.sh cairn_bootstrap_apply) did not leave a working venv: $(printf '%s | ' ${CAIRN_BOOTSTRAP_FINDINGS+"${CAIRN_BOOTSTRAP_FINDINGS[@]}"})"
}

_floor_db() {
  local sock="$CAIRN_PG_SOCKET_DIR/.s.PGSQL.5432"
  [[ -S "$sock" ]] && return 0
  # The socket file is a cheap read that can lie both ways (absent while a server binds a
  # port only; present after a crash) — the miss path asks the real question.
  if command -v pg_isready >/dev/null 2>&1 && pg_isready -h "$CAIRN_PG_SOCKET_DIR" -p 5432 -q 2>/dev/null; then
    return 0
  fi
  local started
  started="$(sudo -n systemctl start postgresql.service 2>&1)" || _floor_refuse db \
    "postgres is down at $sock and this user could not start it (sudo -n systemctl start postgresql.service: ${started:-refused}); lay the sudoers line once — the ollama line's twin, for /bin/systemctl start postgresql.service — or run: cairn sudorelay"
  local i=0
  while (( i < 75 )); do
    [[ -S "$sock" ]] && return 0
    sleep 0.2; i=$((i + 1))
  done
  _floor_refuse db "postgres was started (systemctl start postgresql.service returned 0) but $sock did not appear within 15s"
}

_floor_instance() {
  [[ -d "$INSTANCE_ROOT/cairn/0" ]] && return 0
  # shellcheck source=/dev/null
  source "$HERE/../launchers/bootstrap.sh" 2>/dev/null || true
  if declare -F cairn_wire_instances >/dev/null 2>&1; then
    CAIRN_INSTANCE_ROOT="$INSTANCE_ROOT" cairn_wire_instances >/dev/null 2>&1 || true
  fi
  # Class-space wires no cairn/0 bin, so the cairn device's instance home — where the ground
  # loop's liveness record and the sail record live — is made here, as its machines would on
  # first write.
  mkdir -p "$INSTANCE_ROOT/cairn/0" 2>/dev/null || true
  [[ -d "$INSTANCE_ROOT/cairn/0" ]] && return 0
  _floor_refuse instance "$INSTANCE_ROOT/cairn/0 was absent and could not be laid (launchers/bootstrap.sh cairn_wire_instances + mkdir)"
}

_floor() {
  _floor_venv
  export PATH="$CAIRN_VENV/bin:$PATH"   # the launcher's python3 IS the floor, not whatever came first
  _floor_db
  _floor_instance
}
_floor

# THE TWO TOKENS THE DISPATCHER RESOLVES ARE FOLDED; everything after rides verbatim
# (ruled 2026-09-07: system words are case-insensitive when Akien types them; his free
# text is never touched — cairn/tools/system_word is the rule's one address).
#
# FOLD FIRST, THEN SPLIT, and the order is not incidental: `CC.1` and `cc.1` have to be
# one address, and splitting first would leave the device half unfolded on one branch and
# folded on the other. Folding the whole token is safe because the instance half is
# digits, which fold to themselves.
device="${1,,}"; shift
typed="$device"          # the token AS TYPED (folded), for the refusals that must echo it

# --- the instance comes off the device token; 0 is the DEFAULT, not a second path ---
instance=0
case "$device" in
  *.*) instance="${device#*.}"; device="${device%%.*}" ;;
esac

# A non-numeric instance is its OWN refusal, and it fires BEFORE the folder lookup: a typo
# in the instance must not come back as a missing device, which is the one wrong answer
# this branch can give (Law 7 — the diagnostic surface names the real lack).
case "$instance" in
  ''|*[!0-9]*)
    echo "cairn $typed: instance must be a number, got: ${instance:-<empty>}" >&2
    exit 127
    ;;
esac

# --- device dispatch: ~/.cairn/devices/<device>/<instance>/bin/<verb> ---
device_bin="$INSTANCE_ROOT/$device/$instance/bin"

if [ -d "$device_bin" ]; then
  if [ $# -eq 0 ]; then
    # no verb: self-named launcher
    verb="$device"
  elif [ -x "$device_bin/${1,,}" ]; then
    # $1 names a real verb in this device's bin (folded: a verb is a system word)
    verb="${1,,}"; shift
  else
    # $1 is not a verb — pass everything to the self-named launcher
    verb="$device"
  fi
  target="$device_bin/$verb"
  if [ ! -x "$target" ]; then
    echo "cairn $device: no such verb: $verb" >&2
    echo "verbs for $device:" >&2
    local_found=0
    for f in "$device_bin"/*; do
      if [ -f "$f" ] && [ -x "$f" ]; then
        echo "  $(basename "$f")" >&2
        local_found=1
      fi
    done
    [ "$local_found" -eq 0 ] && echo "  (none)" >&2
    exit 127
  fi
  exec "$target" "$@"
fi

# --- a device we HAVE, at an instance we do not: refuse by name -------------
# The shape is bin/cairn's own unknown-verb refusal, one rung up: say what was asked for,
# then list what there is, one per line, on stderr, exit 127. A device that exists and an
# instance that does not is a different lack from "no such device", and collapsing the two
# is how `cairn cc.7 restart` would read as "cc isn't a device" (Law 7).
if [ -d "$INSTANCE_ROOT/$device" ]; then
  inst_found=0
  for d in "$INSTANCE_ROOT/$device"/*/bin; do
    [ -d "$d" ] || continue
    inst_found=1
  done
  if [ "$inst_found" -eq 1 ]; then
    echo "cairn $typed: no such instance: $instance" >&2
    echo "instances for $device:" >&2
    for d in "$INSTANCE_ROOT/$device"/*/bin; do
      [ -d "$d" ] || continue
      echo "  $(basename "$(dirname "$d")")" >&2
    done
    exit 127
  fi
fi

# --- legacy fallback: bin/cmd/<verb> (transitional) ---
# Only for an UNDOTTED token: `cairn foo.1` asked for an instance of a device, and the
# legacy verbs have no instances to ask for.
if [ "$typed" = "$device" ]; then
  legacy_target="$LEGACY_CMD_DIR/$device"
  if [ -f "$legacy_target" ] && [ -x "$legacy_target" ]; then
    exec "$legacy_target" "$@"
  fi
fi

# --- nothing matched ---
# The token AS TYPED, dot and all: the operator gets back what they typed, not the half of
# it this script happened to keep.
echo "cairn: no such device or command: $typed" >&2
_usage
exit 127
