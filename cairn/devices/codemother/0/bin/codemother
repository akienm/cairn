#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"

subcmd="${1:-}"; subcmd="${subcmd,,}"   # a subcommand is a system word (ruled 2026-09-07)
shift 2>/dev/null || true

case "$subcmd" in
  cross)
    # The falsifier's clause 1 names this command by name. It is a THIN mouth: it
    # reaches the two shims and posts one envelope. Every judgement — who the actor is,
    # whether the boat stands proven — belongs to the door, not to this file.
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
args = sys.argv[1:]
def _flag(name):
    if name in args:
        i = args.index(name)
        return args[i + 1] if i + 1 < len(args) else None
    return None
pos = []
skip = False
for i, a in enumerate(args):
    if skip:
        skip = False
        continue
    if a.startswith('--'):
        skip = True
        continue
    pos.append(a)
if len(pos) < 2:
    print('usage: cairn codemother cross <ticket> <target> --proven-by <proof path> [--history <path>] [--state <path>]')
    sys.exit(1)
ticket, target = pos[0], pos[1]
proven_by = _flag('--proven-by')
if not proven_by:
    print('cross needs --proven-by <proof path>: Law 8 asks a hand to name the proof that stands, and no ticket field carries one (censused 2026-09-09: 0 of 258).')
    sys.exit(1)
from cairn.tools.base.bus_client import reach
bus = reach('codemother', 'harbor_master')
body = {'ticket': ticket, 'target': target, 'proven_by': proven_by}
for flag, key in (('--history', 'history_path'), ('--state', 'state_path'), ('--workflow', 'workflow')):
    v = _flag(flag)
    if v:
        body[key] = v
reply = bus.request(sender='cairn-codemother-cli', to='codemother', verb='cross',
                    why='cairn codemother cross ' + ticket + ' ' + target,
                    body=body, timeout=float(_flag('--timeout') or 240.0))
answer = reply.get('body') or {}
print(json.dumps(answer, indent=2, default=str))
sys.exit(0 if answer.get('accepted') else 1)
" "$@"
    ;;
  watch)
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.watch import activate, on_question
area = sys.argv[1] if len(sys.argv) > 1 else ''
if not area:
    print('usage: cairn codemother watch <area> [reason]')
    sys.exit(1)
reason = sys.argv[2] if len(sys.argv) > 2 else 'cli activation'
result = activate(area, reason)
print(json.dumps(result, indent=2))
" "$@"
    ;;
  question)
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.watch import on_question
q = ' '.join(sys.argv[1:]) if len(sys.argv) > 1 else ''
if not q:
    print('usage: cairn codemother question <question>')
    sys.exit(1)
result = on_question(q)
print(json.dumps(result, indent=2))
" "$@"
    ;;
  seed)
    exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.seed_trees import seed
dry = '--dry-run' in sys.argv[1:]
result = seed(dry_run=dry)
print(json.dumps(result, indent=2))
if result['errors']:
    sys.exit(1)
" "$@"
    ;;
  show)
    what="${1:-}"; what="${what,,}"
    shift 2>/dev/null || true
    case "$what" in
      dashboard)
        exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.dashboard import format_dashboard
print(format_dashboard())
" "$@"
        ;;
      *)
        echo "usage: cairn codemother show dashboard" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.shim import CodeMotherShim
shim = CodeMotherShim()
print(f'device: {shim.device_id}')
print(f'class:  cairn/devices/codemother/')
# The verbs are the DEVICE's, read through the same declared_verbs() the shim dispatches on
# (cairn/tools/base/shim.py deliver). The shim once carried a tuple of its own and nothing
# read it; a help text compiled from a second list is a help text that can be wrong.
print(f'verbs:  {\" \".join(shim.declared_contract()[\"verbs\"])}')
print()
print('commands:')
print('  cairn codemother cross <ticket> <target> --proven-by <proof>')
print('                                           — clear a boat through the harbor door as codemother')
print('  cairn codemother watch <area> [reason]  — fire spreading activation')
print('  cairn codemother question <question>     — ask about an area')
print('  cairn codemother seed [--dry-run]        — plant cognition questions into trees')
print('  cairn codemother show dashboard          — full coding system view')
" "$@"
    ;;
esac
