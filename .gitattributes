# Shell scripts run under Git Bash on Windows; CRLF breaks them. LF in the working tree.
bin/cairn text eol=lf
bin/cmd/* text eol=lf
bin/logger_for_bash text eol=lf
launchers/* text eol=lf
*.sh text eol=lf
cairn/devices/**/bin/* text eol=lf
*.cmd text eol=crlf

# Records are byte-exact artifacts (the artifact door canonical form): LF everywhere, never autocrlf.
*.json text eol=lf
*.jsonl text eol=lf
