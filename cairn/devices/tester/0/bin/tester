#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"
exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.tester.shim import TesterShim
shim = TesterShim()
print(f'device: {shim.device_id}')
print(f'class:  cairn/devices/tester/')
" "$@"
