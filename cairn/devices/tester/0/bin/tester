#!/usr/bin/env bash
# cairn tester [verb] [args...] — the root verbs (list show get stop start settings, and the
# `hot` modifier) resolve in the shim base, one resolver for every device (ticket b41b0c0fff0e).
# No arguments prints the device and its class, as it always has.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"
exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.tester.shim import TesterShim
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(TesterShim, sys.argv[1:]))
" "$@"
