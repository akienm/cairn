#!/usr/bin/env bash
# cairn cairn [verb] [args...] — the cairn device's self-named launcher, laid at its instance
# address by bin/cairn's floor like every other device's (ticket 50ca14d4489e). The root verbs
# resolve in the shim base (ticket b41b0c0fff0e). No arguments prints the device and its class.
# The top-level shortcuts (start, stop, restart) stay at cairn/devices/cairn/bin/ (outline 5.4.3.3).
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"
exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.cairn.shim import CairnShim
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(CairnShim, sys.argv[1:]))
" "$@"
