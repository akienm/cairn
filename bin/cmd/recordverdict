#!/usr/bin/env bash
# RETIRED 2026-08-29 — successor: cairn review
# Reason: the approve/disprove adjudication model is replaced by cairn review,
# where corrections carry the training data as words, not a binary signal.
# Ticket: recordverdict-retires-in-favor-of-review
#
# The learning_block.record_verdict PRIMITIVE stays until the skilldial migrates.
# This CLI face retires; the primitive is a separate, later retirement.
#
# Original: cairn recordverdict — Akien's gate act from his own shell (ticket recordverdict-cli-door).
#
# A thin registration against the cairn dispatcher: exec into the primitive's shell
# door, args verbatim, exit code intact. NO logic here — the learning_block owns the
# door (Law 6), and this wrapper adds no second path into CairnCommons/learning/.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"       # bin/cmd -> bin -> repo root (where the cairn package is)

cd "$REPO"
exec python3 -m cairn.machines.learning_block recordverdict "$@"
