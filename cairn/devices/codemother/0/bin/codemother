#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"

subcmd="${1:-}"; subcmd="${subcmd,,}"   # a subcommand is a system word (ruled 2026-09-07)
shift 2>/dev/null || true

case "$subcmd" in
  *)
    # A non-empty line that names no script in this bin is a root verb (list show get stop start
    # settings, `hot` modifier) and resolves in the shim base (ticket b41b0c0fff0e); only the
    # bare `cairn codemother` prints this help.
    if [ -n "$subcmd" ]; then
      exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.shim import CodeMotherShim
from cairn.tools.base.shim import cli_main
sys.exit(cli_main(CodeMotherShim, sys.argv[1:]))
" "$subcmd" "$@"
    fi
    exec python3 -c "
import sys; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.codemother.shim import CodeMotherShim
shim = CodeMotherShim()
print(f'device: {shim.device_id}')
print(f'class:  cairn/devices/codemother/')
# The verbs are the DEVICE's, read through the same declared_verbs() the shim dispatches on
# (cairn/tools/base/shim.py deliver). The shim once carried a tuple of its own and nothing
# read it; a help text compiled from a second list is a help text that can be wrong.
print(f'verbs:  {\" \".join(shim.declared_contract()[\"verbs\"])}')
print()
print('commands:')
print('  cairn codemother cross <ticket> <target> --proven-by <proof>')
print('                                           — clear a boat through the harbor door as codemother')
print('  cairn codemother watch <area> [reason]  — fire spreading activation')
print('  cairn codemother question <question>     — ask about an area')
print('  cairn codemother seed [--dry-run]        — plant cognition questions into trees')
print('  cairn codemother show dashboard          — full coding system view')
" "$@"
    ;;
esac
