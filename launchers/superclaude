#!/usr/bin/env bash
# superclaude — Cairn's Claude Code launcher.
#
# Canonical home: cairn/launchers/superclaude  (symlinked onto PATH via ~/.local/bin;
# a convenience pointer also sits at the repo root: cairn/superclaude).
# Charter + why: cairn/launchers/intention+why.json
#
# ── WHAT ─────────────────────────────────────────────────────────────────────
# Launches Claude Code with Cairn's standing session contract:
#   - session name       <hostname>_cc_0   (singleton = instance 0, not a special case)
#   - remote control      on, same name
#   - permission prompts   bypassed (dangerous — a trusted local dev box)
#   - context window       a two-state switch (1M / 200K); see the WHY below
# Every other argument is forwarded to `claude` untouched.
#
# ── WHY the context switch is built the way it is ────────────────────────────
# (This was learned the hard way: the quarry's launcher had this exact logic but
#  NOT its why written down, so it got misread. The why lives here now.)
#
# It is a switch with TWO states, and THE COMMAND LINE ALWAYS WINS:
#   * Big design work wants 1M — opt up with --1m.
#   * Heavy buildout (lots of small tickets) defaults to 200K. The real why, stronger
#     than mere convenience: Claude cannot self-trigger /compact, so at 1M the context
#     balloons past Akien's notification threshold before he is alerted. Defaulting to
#     200K makes stewardship of resources a property of the system (physics, Law 4), not
#     of anyone remembering to pass --200k (discipline). Flipping the built-in default is
#     a one-line edit (FILE_DEFAULT_200K), currently 1 = 200K.
#   * --1m  opts UP: it *unsets* any 200K constraint, so it wins even over a 200K
#           environment. (unset, NOT =0 — the disable var only ever turns 1M OFF;
#           =0 is a no-op that merely looks like it worked.)
#   * --200k opts DOWN: it imposes the 200K constraint.
#   * If nothing decides — no flag, no environment var, no file default — it launches
#     UNCONSTRAINED (1M). Precedence, highest first: command line > environment > file
#     default > unconstrained.
#
# NOTE (measured caveat): docs say an unset constraint makes 1M *available*, while
# the [1m] model variant is what *selects* it. Empirically, unset yields 1M in this
# environment (the session that wrote this file was 1M). If a --1m launch ever comes
# up 200K, that's the signal to also point the model at a [1m] variant — set
# SUPERCLAUDE_1M_MODEL and export ANTHROPIC_DEFAULT_OPUS_MODEL below. Not before.
#
# NOT set -e: from here to `exec claude`, nothing may abort the launch — the prime
# directive is to always reach Claude Code so it can help rebuild a broken box.
set -uo pipefail

# ── FILE DEFAULT — edit THIS ONE LINE to flip the built-in default ───────────
# Applies only when neither the environment nor the command line decides.
#   0 = no file constraint  → unconstrained (1M) when the env is silent  [big-design default]
#   1 = default to 200K     → 200K when the env is silent               [small-ticket default]
FILE_DEFAULT_200K=1

show_help() {
  cat <<'HELP'
superclaude — Cairn's Claude Code launcher.

  Standing contract (always applied):
    --name <hostname>_cc_0              stable singleton session name
    --remote-control <hostname>_cc_0    remote control on, same name
    --dangerously-skip-permissions      bypass permission prompts

  Context window — a two-state switch; the command line always wins:
    --1m            opt UP: unset any 200K constraint (wins over a 200K environment)
    --200k, --no-1m opt DOWN: impose the 200K constraint
    (neither)       inherit the environment; if it's silent, the file default; if
                    that's silent too, launch unconstrained (1M)

  Launcher-only:
    --dry-run       print the resolved context state + claude command, do not launch
    --no-preflight  skip the floor check entirely (rescue hatch: use if the preflight
                    itself is what's broken — the launch must always be reachable)
    -h, --help      this message

  Preflight — superclaude gets itself started (cairn/launchers/bootstrap.sh):
    Brings up the venv + editable install so `cairn` imports from anywhere, then
    hands Claude a report of whatever it could NOT fix, so the session opens already
    knowing. Silent when the floor is up. It can never abort the launch.

  Flip the built-in default by editing FILE_DEFAULT_200K in this file.
  All other arguments are forwarded to `claude` unchanged, e.g.:
    superclaude --1m --model claude-opus-4-8
HELP
}

# ── parse OUR flags; forward everything else ─────────────────────────────────
want_1m=0
want_200k=0
dry_run=0
no_preflight=0
pass=()
for arg in "$@"; do
  case "$arg" in
    --1m)            want_1m=1 ;;
    --200k|--no-1m)  want_200k=1 ;;
    --dry-run)       dry_run=1 ;;
    --no-preflight)  no_preflight=1 ;;
    -h|--help)       show_help; exit 0 ;;
    *)               pass+=("$arg") ;;
  esac
done

# ── resolve the context switch (command line > environment > file > unconstrained)
# The state variable IS Claude Code's own control var, CLAUDE_CODE_DISABLE_1M_CONTEXT.
context_state=""   # for --dry-run reporting: "1M" | "200K"
if [[ "$want_1m" -eq 1 ]]; then
  unset CLAUDE_CODE_DISABLE_1M_CONTEXT 2>/dev/null || true       # --1m wins: unconstrained
  context_state="1M (command line --1m)"
elif [[ "$want_200k" -eq 1 ]]; then
  export CLAUDE_CODE_DISABLE_1M_CONTEXT=1                        # --200k wins: 200K
  context_state="200K (command line --200k)"
elif [[ -n "${CLAUDE_CODE_DISABLE_1M_CONTEXT:-}" ]]; then
  # environment already decided — leave it exactly as inherited
  [[ "$CLAUDE_CODE_DISABLE_1M_CONTEXT" == "1" ]] \
    && context_state="200K (environment)" \
    || context_state="1M (environment)"
elif [[ "$FILE_DEFAULT_200K" -eq 1 ]]; then
  export CLAUDE_CODE_DISABLE_1M_CONTEXT=1                        # file default: 200K
  context_state="200K (file default)"
else
  context_state="1M (unconstrained — nothing decided)"          # nothing said → unconstrained
fi

# ── session identity: <hostname>_cc_0 ────────────────────────────────────────
host=$(hostname | cut -d. -f1 | tr '[:upper:]' '[:lower:]')
session="${host}_cc_0"

# ── preflight: get ourselves started ─────────────────────────────────────────
# "Launch with as many of the things as you can already working" (Akien, 2026-07-30) —
# then TELL CLAUDE what you couldn't fix, so the tool is invisible when it works and
# actionable when it doesn't. Anything the launcher silently swallows becomes tokens
# some future session spends re-deriving; that is the defect this whole block exists for.
#
# THE PRIME DIRECTIVE STILL RULES. Nothing here may abort the launch: the bootstrap sets
# no -e, every call is guarded, and each branch falls through to exec. A broken preflight
# must still deliver Claude Code to a broken box — that is the tier's entire purpose.
#
# IT ALSO KEEPS THE FLIGHT RECORDER (the WATCHME probe). Booting is exactly the situation
# where nothing else is up yet to observe you, so the launcher observes itself: what it
# tried, what came back, what it could not fix, into ~/.cairn/logs/boot. superclaude is a
# CHILD PROCESS, so exporting the namespace here scopes it to this launch and leaves the
# calling shell's own log untouched — the "a new process renames the namespace until it
# completes" property, which costs nothing because it is just how export works.
export CAIRN_LOGTARGET="${CAIRN_BOOT_LOG:-$HOME/.cairn/logs/boot}"
_sc_log() { declare -F lognote >/dev/null 2>&1 && lognote "$@"; return 0; }

# Sourced OUTSIDE the preflight branch on purpose. --no-preflight is the rescue hatch, and
# a launch that used it is the single most interesting line this probe can capture: it means
# the floor check got broken enough that someone routed around it. Recording only the
# launches that took the happy path would make the probe blind to its own failure mode.
_sc_logger="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bin/logger_for_bash"
if [[ -r "$_sc_logger" ]]; then
  # shellcheck source=/dev/null
  source "$_sc_logger" 2>/dev/null || true
fi
_sc_log "launch: argv=[$*] session=$session context=$context_state preflight=$([[ "$no_preflight" -eq 1 ]] && echo bypassed || echo on)"

preflight_arg=()
if [[ "$no_preflight" -eq 0 ]]; then
  bootstrap="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/bootstrap.sh"
  if [[ -r "$bootstrap" ]]; then
    # shellcheck source=/dev/null
    source "$bootstrap" || true
    if declare -F cairn_bootstrap_verify >/dev/null 2>&1; then
      # verify first: the warm path is ~90ms and does no work. apply only on a real miss,
      # so the common launch pays a rounding error rather than a pip run (Law 1 — the
      # settled floor is not re-derived on every launch).
      preflight_t0="${EPOCHREALTIME:-0}"
      cairn_bootstrap_verify >/dev/null 2>&1 || cairn_bootstrap_apply >/dev/null 2>&1 || true
      # The venv goes on PATH ahead of system python, so `python3` inside the session IS
      # the floor we just laid. Without this the session would still reach system python
      # and the whole preflight would be theatre.
      venv_bin="$(cairn_venv_dir)/bin"
      [[ -d "$venv_bin" ]] && export PATH="$venv_bin:$PATH"
      residue="$(cairn_bootstrap_report 2>/dev/null)" || true
      [[ -n "$residue" ]] && preflight_arg=(--append-system-prompt "$residue")
      # The cost, every launch, in the record — so "the preflight got slow" is a thing
      # someone can SEE rather than suspect. A tool that is invisible when it works has
      # to prove it stayed cheap, or invisible eventually means unaccountable.
      _sc_log "preflight: done in $(awk -v a="${EPOCHREALTIME:-0}" -v b="$preflight_t0" \
        'BEGIN{printf "%.0f", (a-b)*1000}' 2>/dev/null)ms · residue=$([[ -n "$residue" ]] && echo yes || echo none)"
    fi
  else
    # Loud, never silent (CP1) — but still not fatal.
    echo "superclaude: preflight skipped — bootstrap.sh not readable at $bootstrap" >&2
    _sc_log "preflight: SKIPPED — bootstrap.sh not readable at $bootstrap"
  fi
else
  _sc_log "preflight: skipped by --no-preflight"
fi

# ── assemble the launch ──────────────────────────────────────────────────────
claude_bin="${CLAUDE_BIN:-claude}"
set -- \
  --name "$session" \
  --remote-control "$session" \
  --dangerously-skip-permissions \
  ${preflight_arg[@]+"${preflight_arg[@]}"} \
  ${pass[@]+"${pass[@]}"}

# The last line before the shell is replaced. If a launch ever vanishes without reaching
# Claude Code, this is the line that says how far it got — and the prime directive says it
# always should, so a boot log whose last entry is not `exec:` is a defect with a timestamp.
# Rendered with %q rather than interpolated: the argv can carry a whole multi-line
# preflight report, and the point of this line is that it can be pasted back and re-run.
if declare -F _logbash_render >/dev/null 2>&1; then
  _sc_log "exec: $(_logbash_render "$claude_bin" "$@")"
else
  _sc_log "exec: $claude_bin $*"
fi

# ── THE GROUND LOOP IS ALWAYS UP (ruled by Akien 2026-08-11) ─────────────────
# "THE INTENTION IS THE GROUND LOOP IS ALWAYS UP. IF ITS NOT UP, LAUNCHING AN ENTRY POINT
# LAUNCHES IT. NO SYSTEM LEVEL STARTUP REQUIRED. NO MATTER HOW MANY LAUNCHES ARE ATTEMPTED,
# ITS A SINGLETON, SO IF IT SEES ITS ALREADY RUNNING, THE NEW ONE STOPS."
#
# SPAWN BLIND — deliberately. This does NOT check whether a loop is running first; the
# singleton claim in cairn/devices/ground_loop/guard.py is the mechanism, and a launcher that
# re-derived the check would be a second opinion about who is running (Law 1, and the guard's
# own docstring names this caller). A loser exits 3 after printing what it found, which lands
# in the log below — distinct from a crash, so "refused, one is running" reads differently
# from "broke".
#
# WHY IT WAS MISSING: the guard shipped 2026-08-09 built expressly for an entry point to call,
# and no entry point ever called it. The loop ran exactly once, started by hand, and the
# 2026-08-10 reboot took it — 74,209 beats, then nothing, and nothing was loud about it.
#
# Backgrounded, detached, /dev/null on stdin, and `|| true`, under the same prime directive as
# the trace wire: from parse to exec, nothing may abort the launch. A heartbeat that fails to
# start must cost the session nothing.
#
# AND IT IS A UNIT, NOT A setsid — because setsid detaches a TTY and NOT A CGROUP. That one
# word is what this block used to get wrong, and its own comment said "setsid so it outlives
# this shell and the terminal", which was true of the tty and false of the terminal. MEASURED
# 2026-08-18: the kernel oom-killed the claude binary at 14:57:31, systemd marked
# app-org.kde.konsole-b1d62b21….scope "Failed with result 'oom-kill'" at 14:57:43, and the
# loop's own trail carries starts at 14:52:55 and 14:58:01 with NOTHING between — the
# heartbeat went down inside the terminal's cgroup, because that is where setsid left it.
# It died the same way on 2026-08-10 (74,209 beats, then nothing, and nothing was loud).
#
# `systemd-run --user --unit=` parents it on the USER MANAGER instead:
# /user.slice/user-1000.slice/user@1000.service/app.slice/cairn-ground-loop.service — a
# SIBLING of the Konsole scope and of the session scope rather than a child of either. This
# is NOT system-level startup and adds none (Akien's ruling 2026-08-11): a transient unit is
# created by this launch, survives no reboot, and is `enable`d nowhere.
#
# THREE THINGS THAT LOOK OPTIONAL AND ARE NOT, each measured on this host 2026-08-18:
#
#   SuccessExitStatus=3 — a transient unit that exits ZERO is garbage-collected and frees
#   its name; one that exits NONZERO stays loaded in `failed` state and BLOCKS it. The
#   singleton loser exits 3 BY DESIGN, so without this the FIRST losing launch would wedge
#   the name and every later launch would silently start nothing — "always up" broken by the
#   very change meant to secure it. Verified: exit 3 under this flag leaves `is-failed` rc=4
#   and the name free.
#
#   reset-failed, fired blind — for the crash case the flag does not cover. Verified against
#   a LIVE unit: rc=0, MainPID unchanged, still active, so it cannot disturb a running loop;
#   against a name that does not exist it is rc=1 "not loaded", hence the `|| true`.
#
#   --setenv=HOME/--setenv=PATH — `systemd-run --user` hands the unit the MANAGER's
#   environment, not this shell's. Verified: PATH came back without ~/.cairn/venv/bin, so the
#   loop would have run under /usr/bin/python3 rather than the interpreter the preflight just
#   laid — the preflight's whole point is that `python3` in this session IS that floor.
#
#   StandardOutput/StandardError=append: — a unit does not inherit this shell's redirect, and
#   without it the losing claimant's refusal (the line that tells "refused, one is running"
#   apart from "broke") would vanish into the journal. The systemd-run call ITSELF is
#   redirected to the same file for the same reason, and that covers the OTHER refusal: if
#   the unit name is already taken, systemd-run's "was already loaded or has a fragment
#   file" is the only evidence a start never happened, and it must not read like one that
#   did. Both refusals therefore land in one file a human already opens.
#
# GUARDED, and the fall-through is today's spawn unchanged: if systemd-run is missing, or the
# manager refuses for a reason that is NOT "that name is taken", setsid — worse parenting, but
# a launch. The boot log names which path it took, exactly as the memory-scope block below does.
#
# ONE ROUND TRIP ON THE PATH EVERY LAUNCH TAKES, and it is that shape because it was MEASURED
# into it (2026-08-18, n=7 each, this host). The first draft asked the manager three questions
# before the loop existed: a `--scope true` liveness probe (46ms median), a blind `reset-failed`
# (30ms), then the start (46ms) — 125ms of dbus round trips on every launch, against a launcher
# that reaches `exec` in ~88ms. The ticket this block was built under lists DELAY in its
# falsifier, so two of the three had to go, and they went by being ANSWERED FROM EVIDENCE
# rather than ASKED IN ADVANCE:
#
#   the liveness probe is gone — THE START ATTEMPT IS THE PROBE. "Could a scope be made?" was a
#   proxy standing in front of "did the unit start?", which is asked anyway one line later. The
#   replacement is also STRICTER, not merely cheaper: the old shape committed to the systemd
#   path the moment the proxy passed, so a probe that passed and a start that then failed left
#   the launch with no loop at all.
#
#   reset-failed moved to the retry, where the state it clears actually exists. SuccessExitStatus=3
#   already stops the ordinary singleton loser from wedging its name, so a wedged name means a
#   genuine crash — rare. Paying 30ms on every launch to clear a state almost no launch is in is
#   exactly the cost the common path should not carry.
#
# AND WHICH FAILURE IT WAS DECIDES WHAT HAPPENS NEXT — the two must not collapse into "it
# didn't work". "Unit … was already loaded or has a fragment file" means the NAME is held: by a
# live loop, or by a dead unit's corpse. The answer is reset-failed-and-retry, and then, if it
# still will not start, a REFUSAL — never a setsid spawn, because a setsid spawn here is a
# second claimant racing the first, which is the very thing the singleton guard exists to stop
# (two loops held the address for 80 minutes on 2026-08-18 and nothing was loud about it). Any
# OTHER failure — no bus, no manager, denied — is systemd being unreachable, and there the
# setsid fall-through is right, because there is no first claimant to race.
_sc_loop_unit="${SUPERCLAUDE_GROUND_LOOP_UNIT:-cairn-ground-loop}"
_sc_loop_log="${HOME}/.cairn/logs/ground_loop_nohup.log"
_sc_loop_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)"

# Spelled ONCE so the retry cannot drift from the first attempt — the retry differs from the
# first try in nothing but the reset that precedes it, and a second copy of eight flags is a
# place for that to stop being true. stderr comes back on stdout so the caller can READ which
# failure it was; `_sc_loop_note` puts it in the log either way, because a refusal only this
# shell saw is a refusal no human can find (Law 7 at a diagnostic surface).
_sc_loop_start() {
  systemd-run --user --quiet \
    --unit "$_sc_loop_unit" \
    --working-directory "${_sc_loop_root:-$PWD}" \
    --setenv=HOME="$HOME" \
    --setenv=PATH="$PATH" \
    -p SuccessExitStatus=3 \
    -p StandardOutput=append:"$_sc_loop_log" \
    -p StandardError=append:"$_sc_loop_log" \
    -- python3 -m cairn.devices.ground_loop 2>&1
}
_sc_loop_note() {
  [[ -n "${1:-}" ]] || return 0
  printf '%s %s\n' "$(date -Is 2>/dev/null || date)" "$1" >>"$_sc_loop_log" 2>/dev/null || true
}

if [[ "$dry_run" -eq 0 ]]; then
  mkdir -p "$(dirname "$_sc_loop_log")" 2>/dev/null || true
  # started | refused | unavailable — the three outcomes, decided before anything is logged, so
  # the log line and the spawn cannot disagree about which path this launch took.
  _sc_loop_path="unavailable"
  _sc_loop_err=""
  if command -v systemd-run >/dev/null 2>&1; then
    if _sc_loop_err="$(_sc_loop_start)"; then
      _sc_loop_path="started"
    else
      _sc_loop_note "$_sc_loop_err"
      case "$_sc_loop_err" in
        *"already loaded"*|*"fragment file"*|*"already exists"*|*"Unit "*"already"*)
          systemctl --user reset-failed "${_sc_loop_unit}.service" >/dev/null 2>&1 || true
          if _sc_loop_err="$(_sc_loop_start)"; then
            _sc_loop_path="started"
          else
            _sc_loop_note "$_sc_loop_err"
            _sc_loop_path="refused"
          fi
          ;;
      esac
    fi
  fi
  case "$_sc_loop_path" in
    started)
      _sc_log "ground_loop: spawn attempted as ${_sc_loop_unit}.service on the user manager (singleton guard decides; loser exits 3)"
      ;;
    refused)
      # THE REFUSAL IS WRITTEN WHERE A HUMAN LOOKS, not only where systemd files it. The note
      # above already carried systemd-run's own complaint into this file; this line says whose
      # refusal it was, so "started nothing" cannot be mistaken for "started".
      _sc_loop_note "ground_loop: ${_sc_loop_unit}.service refused the start — nothing was spawned, and NOTHING was spawned another way either, because the name being held means a loop already holds it; the lines above are systemd-run's reason"
      _sc_log "ground_loop: ${_sc_loop_unit}.service refused the start — nothing was spawned; see $_sc_loop_log"
      ;;
    *)
      ( setsid python3 -m cairn.devices.ground_loop \
          >>"$_sc_loop_log" 2>&1 </dev/null & ) >/dev/null 2>&1 || true
      disown 2>/dev/null || true
      _sc_log "ground_loop: systemd-run unavailable — spawned with setsid, which leaves it in THIS cgroup and it will die with this window (singleton guard decides; loser exits 3)"
      ;;
  esac
fi

# ── THE WEB SERVER IS ALWAYS UP (same ruling, generalized) ───────────────────
# The librarian's web face answers on http://10.0.0.229/ — the same "if it's not up,
# launching an entry point launches it" principle as the ground loop above. The web_server
# listener is NOT a daemon: it acts only when a browser request arrives. It wires up the
# ground loop with the librarian's shim, so the chat window is live at /device/librarian.
#
# Same transient-unit pattern: SuccessExitStatus is unnecessary here (the listener doesn't
# exit 3 — it's not a singleton guard, it just binds a port and serves), but the retry and
# setsid fallback apply. The listener is idempotent in practice: if port 80 is already
# bound, the second one fails to bind and exits — but unlike the ground loop, that failure
# is an OS error, not a designed exit code, so we check the port first to avoid a noisy
# failure in the log.
_sc_web_unit="${SUPERCLAUDE_WEB_UNIT:-cairn-web-server}"
_sc_web_log="${HOME}/.cairn/logs/web_server.log"
_sc_web_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)"

_sc_web_start() {
  systemd-run --user --quiet \
    --unit "$_sc_web_unit" \
    --working-directory "${_sc_web_root:-$PWD}" \
    --setenv=HOME="$HOME" \
    --setenv=PATH="$PATH" \
    -p StandardOutput=append:"$_sc_web_log" \
    -p StandardError=append:"$_sc_web_log" \
    -- python3 "$_sc_web_root/cairn/devices/web_server/listener.py" 2>&1
}

if [[ "$dry_run" -eq 0 ]]; then
  mkdir -p "$(dirname "$_sc_web_log")" 2>/dev/null || true
  if ss -tlnH 2>/dev/null | grep -q ':80\b'; then
    _sc_log "web_server: already listening on port 80"
  elif command -v systemd-run >/dev/null 2>&1; then
    _sc_web_err=""
    if _sc_web_err="$(_sc_web_start)"; then
      _sc_log "web_server: started as ${_sc_web_unit}.service"
    else
      _sc_loop_note "$_sc_web_err"
      case "$_sc_web_err" in
        *"already loaded"*|*"fragment file"*|*"already exists"*|*"Unit "*"already"*)
          systemctl --user reset-failed "${_sc_web_unit}.service" >/dev/null 2>&1 || true
          if _sc_web_err="$(_sc_web_start)"; then
            _sc_log "web_server: started as ${_sc_web_unit}.service (after reset-failed)"
          else
            _sc_loop_note "$_sc_web_err"
            _sc_log "web_server: ${_sc_web_unit}.service refused — see $_sc_web_log"
          fi
          ;;
        *)
          _sc_log "web_server: systemd-run failed: $_sc_web_err"
          ;;
      esac
    fi
  else
    ( setsid python3 "$_sc_web_root/cairn/devices/web_server/listener.py" \
        >>"$_sc_web_log" 2>&1 </dev/null & ) >/dev/null 2>&1 || true
    disown 2>/dev/null || true
    _sc_log "web_server: systemd-run unavailable — spawned with setsid"
  fi
fi

# ── THE TRACE WIRE (deploy pass, approved 2026-08-01): a launch is a firing ──
# door_pass on a clean floor; send_back with the lack NAMED when the preflight was
# bypassed or left residue — launched anyway (the prime directive is untouched), but
# COUNTED: the boot log tells one launch's story, the trace makes launches a rate.
# Backgrounded and `|| true` by the same directive: the wire may never slow or abort
# the launch. A dry-run is not a launch and traces nothing.
if [[ "$dry_run" -eq 0 ]]; then
  _sc_wire_event="door_pass"; _sc_wire_lacks=()
  if [[ "$no_preflight" -eq 1 ]]; then
    _sc_wire_event="send_back"; _sc_wire_lacks+=("preflight bypassed by --no-preflight")
  elif [[ -n "${residue:-}" ]]; then
    _sc_wire_event="send_back"; _sc_wire_lacks+=("preflight residue: $residue")
  fi
  ( python3 -m cairn.machines.learning_block trace superclaude "$_sc_wire_event" launch \
      ${_sc_wire_lacks[@]+"${_sc_wire_lacks[@]}"} >/dev/null 2>&1 || true ) &
  disown 2>/dev/null || true
fi

if [[ "$dry_run" -eq 1 ]]; then
  echo "# superclaude --dry-run"
  echo "# context: $context_state"
  echo "# CLAUDE_CODE_DISABLE_1M_CONTEXT=${CLAUDE_CODE_DISABLE_1M_CONTEXT:-<unset>}"
  printf 'exec %s' "$claude_bin"
  printf ' %q' "$@"
  echo
  exit 0
fi

# ── THE SESSION RUNS IN ITS OWN CGROUP (measured 2026-08-18) ────────────────
# Claude Code has taken this laptop down three times by growing to ~12-14GB anon RSS on a
# 15GB box: 2026-08-11 (2.1.226, 13.7GB), 2026-08-13 (2.1.229, 12.5GB), 2026-08-18 14:57
# (2.1.232, 12.4GB). All three were a GLOBAL oom-kill (constraint=CONSTRAINT_NONE), and a
# global kill does not stop at the offender: systemd marked the whole Konsole scope
# `Failed with result 'oom-kill'` and every sibling in that terminal died with it — on the
# third one that included the running sudo_relay, i.e. Akien's live root window.
#
# THE CAP DOES NOT FIX THE GROWTH; IT FIXES THE BLAST RADIUS. Inside a scope with a limit
# the kernel does a CONSTRAINT_MEMCG kill instead — verified here 2026-08-18 15:02, a 100M
# scope killed its own python3 and touched nothing else. So a runaway session dies alone
# and the terminal, the relay and the desktop stay up.
#
# MemorySwapMax is not optional: with swap unbounded the same test walked straight past a
# 100M MemoryMax into 400MB of swap and never tripped. Unbounded swap is also what turned
# the 14:57 incident into minutes of thrash (3.6GB swap peak on that scope alone).
# MemoryHigh is the soft one — the kernel throttles and reclaims there rather than killing,
# so the session goes visibly slow BEFORE it dies, which is the only warning we get today.
#
# GUARDED, under the prime directive: if systemd-run is missing or the probe fails we exec
# Claude exactly as before. SUPERCLAUDE_NO_SCOPE=1 opts out; the three limits are env-tunable.
_sc_mem_high="${SUPERCLAUDE_MEM_HIGH:-6G}"
_sc_mem_max="${SUPERCLAUDE_MEM_MAX:-8G}"
_sc_mem_swap="${SUPERCLAUDE_MEM_SWAP:-1G}"
if [[ -z "${SUPERCLAUDE_NO_SCOPE:-}" ]] \
   && command -v systemd-run >/dev/null 2>&1 \
   && systemd-run --user --scope --quiet -- true >/dev/null 2>&1; then
  _sc_log "scope: MemoryHigh=$_sc_mem_high MemoryMax=$_sc_mem_max MemorySwapMax=$_sc_mem_swap (unit superclaude-$$.scope)"
  exec systemd-run --user --scope --quiet \
    --unit "superclaude-$$.scope" \
    -p MemoryHigh="$_sc_mem_high" \
    -p MemoryMax="$_sc_mem_max" \
    -p MemorySwapMax="$_sc_mem_swap" \
    -- "$claude_bin" "$@"
fi
if [[ -n "${SUPERCLAUDE_NO_SCOPE:-}" ]]; then
  _sc_log "scope: declined by SUPERCLAUDE_NO_SCOPE — launching unbounded (a runaway session can still take the terminal)"
else
  _sc_log "scope: unavailable (no systemd-run, or the probe failed) — launching unbounded (a runaway session can still take the terminal)"
fi
exec "$claude_bin" "$@"
