#!/usr/bin/env python3
"""cairn slate — print the resumption point. THE SESSION-OPEN PROGRAM.

Akien 2026-07-31, on being shown that SessionStart hooks exist: "it should fire
itself. i didn't know it could!" — and then, on how far it compiles: "Full."

WHAT THIS REPLACES. Until now the first link in the workflow chain was a skill
(/loadslate) that only ran if Akien remembered to type it. Every session that
opened without it opened cold, and nothing anywhere said so. That is discipline
doing a job physics should do (Law 4), and it had been doing it for two weeks
because nobody knew the host already offered the hook.

WHY IT IS A PROGRAM AND NOT A SKILL. A SessionStart hook cannot invoke a skill —
it runs a command and injects stdout into the session's context. So "fires
itself" necessarily means the settled part of the work stops being something the
resolver re-derives by reading files and becomes structure (Law 1). Finding the
newest slate and reading five fields out of it is settled. It compiles.

WHAT DOES *NOT* COMPILE, and is therefore not here: the drift-check between the
slate and MAP.md. The slates charter is explicit that "drift between them is
named, not silently reconciled" — naming drift is judgment, and a program that
tried it would either be silent (the failure) or wrong (the worse failure). This
program prints the slate's own claims and says nothing about whether they hold.

EVERY LINE HERE IS A POINTER, NOT A PROOF (Law 3). The slates charter says it
outright: "a slate that names a file/flag/ticket is a pointer to verify, not a
proof." The banner says so too, in the output, every session — because the one
reader who most needs reminding is the one who just had it handed to them for
free.

THE TROUBLE LANE'S FIRST READER. cairn/trouble/ has been PROVED and orphaned
since 2026-07-25: nothing outside the device imports it, so troubles were raised
into a corpus with an intake and no drain — "worse than no corpus, it is the
APPEARANCE of capture" (the questions store charter). This program is the drain.
Live troubles print at the TOP, above the slate, because a blocked thing you
learn about after reading the plan is a thing you learn about too late.

IT NEVER WEDGES THE SESSION. Every failure path prints loudly and exits 0. A
session-open announcement that can kill session open is a worse defect than the
silence it replaces; loud-and-continue is Law 7's diagnostic half without taking
the session down with it.

--hook: THE OWNER CAN SEE IT RAN. Measured 2026-07-31: the hook fired correctly
and Akien could not tell. SessionStart stdout reaches the model's context and
nothing else, so a dead hook and a healthy one look IDENTICAL from the one seat
that would care — the invisible-failure shape this whole program exists to kill,
reintroduced one layer up. The host already answers it: any hook may return JSON
with a ``systemMessage`` field, which the CLI prints to the user. So under
--hook this emits one JSON object carrying BOTH halves — the banner to the model
via ``additionalContext``, a one-line receipt to Akien via ``systemMessage``.

THE RECEIPT NAMES WHAT IT DID, and that is the whole point of it. A marker that
only ever says "complete" is a check that goes green for the wrong reason: it
confirms a hook fired, not that a slate was read, and it would print just as
cheerfully over a silently wrong answer. So the receipt carries the slate's own
id and the live-trouble count — the two values that MOVE. Akien reads the wrong
slate name and knows instantly; a hollow build that hardcodes a fixed string
fails the proof (case 10).

Plain text remains the default. Running this by hand is the fallback diagnostic
for exactly the failure --hook is meant to surface, and JSON in a terminal at
9am is not a diagnostic.

    python3 bin/proofs/test_slate.py     # exit 0 = green
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent          # <...>/cairn
COMMONS = REPO.parent / "CairnCommons"

# Injectable roots, the same idiom bin/cairn uses for CAIRN_CMD_DIR ("used by the proof
# to point at a stub tree"). Without these the proof would have to read the real commons,
# and a proof over live data can only assert invariants — it could never pin the ONE
# behaviour most worth pinning here (newest-by-date-not-by-mtime), because that needs a
# fixture where the two orders disagree.
SLATES = Path(os.environ.get("CAIRN_SLATES_DIR") or (COMMONS / "slates"))
TROUBLES = os.environ.get("CAIRN_TROUBLES_DIR") or None       # None → the device's own default
ADJUDICATIONS = Path(os.environ.get("CAIRN_ADJUDICATIONS_DIR") or (COMMONS / "adjudications"))
QUESTIONS = Path(os.environ.get("CAIRN_QUESTIONS_DIR") or (COMMONS / "questions"))

# The fields the slates store charter ratifies as the resumption point. Kept in the
# charter's own order, and named here rather than "everything in the file" so a slate
# that grew an extra key (two have) does not silently widen what every session reads.
CARRIED = ("at_sea", "next_direction", "open_threads")

WIDTH = 78

# Opt IN to the hook's JSON shape. Default stays plain text: see the module docstring.
HOOK_FLAG = "--hook"


def _rule(ch: str = "─") -> str:
    return ch * WIDTH


def _wrap(text: str, indent: str = "  ") -> str:
    """Fold prose to WIDTH. Long single tokens (paths, ids) are never broken —
    a path split across a line is a path nobody can copy."""
    out, line = [], indent
    for word in str(text).split():
        if len(line) + len(word) + 1 > WIDTH and line.strip():
            out.append(line.rstrip())
            line = indent + word + " "
        else:
            line += word + " "
    if line.strip():
        out.append(line.rstrip())
    return "\n".join(out)


def _render(value, indent: str = "  ") -> str:
    """A slate field is prose, a list of prose, or a dict. Render each honestly
    rather than json.dumps-ing the lot: this is read by a human at 9am."""
    if isinstance(value, str):
        return _wrap(value, indent)
    if isinstance(value, list):
        parts = []
        for item in value:
            if isinstance(item, str):
                body = _wrap(item, indent + "  ")
                parts.append(indent + "· " + body.lstrip())
            else:
                parts.append(indent + "· " + json.dumps(item, ensure_ascii=False))
        return "\n".join(parts)
    if isinstance(value, dict):
        parts = []
        for k, v in value.items():
            parts.append(f"{indent}{k}:")
            parts.append(_render(v, indent + "  "))
        return "\n".join(parts)
    return _wrap(value, indent)


def _newest_slate() -> tuple[Path | None, dict | None, str | None]:
    """Newest by the slate's own ``date``, then its own ``written_at``, then filename.

    NOT by mtime: 14 slates were bulk-touched at 2026-07-29 18:03 by an unrelated
    edit, so mtime would have named the wrong slate as current — a ranking the
    records themselves already answer correctly.

    ``date`` alone does not: three slates were written on 2026-08-03 and the
    filename tiebreak (alphabetical on the TITLE, which carries no time) named the
    15:50 slate over the 16:41 one, so that session opened one voyage behind and
    did not know /challenge had shipped. ``written_at`` is the door's own stamp of
    the instant it wrote. Slates written before the stamp existed carry none; they
    sort below any stamped slate of the same day (correct — a stamped slate is by
    construction the later writer), and a day of only-unstamped slates falls back
    to the old filename order and SAYS SO rather than presenting a guess as the
    answer (Law 7's diagnostic half).
    """
    if not SLATES.is_dir():
        return None, None, f"no slates directory at {SLATES}"
    files = [p for p in sorted(SLATES.glob("*.json")) if not p.name.startswith("_")]
    if not files:
        return None, None, f"no slates in {SLATES}"

    ranked, unreadable = [], []
    for p in files:
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
        except Exception as exc:                       # a corrupt slate is loud, not fatal
            unreadable.append(f"{p.name}: {exc}")
            continue
        key = (str(data.get("date") or ""), str(data.get("written_at") or ""), p.name)
        ranked.append((key, p, data))

    warns = []
    if unreadable:
        warns.append("unreadable slate file(s): " + "; ".join(unreadable))
    if not ranked:
        return None, None, (" | ".join(warns) if warns else "every slate failed to parse")

    key, path, data = max(ranked, key=lambda r: r[0])
    if not data.get("written_at"):
        same_day = sum(1 for k, _, _ in ranked if k[0] == key[0])
        if same_day > 1:
            warns.append(
                f"{same_day} slates share date {key[0]} and the chosen one carries no "
                f"written_at — this ranking fell back to alphabetical filename order and "
                f"may be naming the wrong slate as current. Verify before trusting it as "
                f"ground truth; the next door-written slate carries the stamp and settles "
                f"it.")
    return path, data, (" | ".join(warns) if warns else None)


def _live_troubles() -> tuple[list[dict], str | None]:
    """Ask the device, never the directory. The trouble lane owns what LIVE means —
    ``live()`` counts a missing or malformed standing as live on purpose, and
    re-deriving that rule here would be a second owner of it (Law 6)."""
    sys.path.insert(0, str(REPO))
    try:
        from cairn.trouble.trouble import TroubleDevice
    except Exception as exc:
        return [], f"trouble lane unreachable: {exc}"
    try:
        return TroubleDevice(TROUBLES).live(), None
    except Exception as exc:
        return [], f"trouble lane failed to read: {exc}"


def _at_the_gate() -> tuple[list[dict], str | None]:
    """Findings awaiting Akien's verdict. The learning_block owns pendingness
    (a question keeps a finding at the gate; only approve/disprove clear it) —
    this lane only renders what the primitive's own reader says (Law 6), the
    same never-a-second-owner rule the trouble lane lives by."""
    sys.path.insert(0, str(REPO))
    try:
        from cairn.learning_block.learning_block import pending_findings
    except Exception as exc:
        return [], f"gate lane unreachable: {exc}"
    try:
        return pending_findings(), None
    except Exception as exc:
        return [], f"gate lane failed to read: {exc}"


def _unadjudicated() -> tuple[list[dict], str | None]:
    """THE LAP — things needing a decision by Akien, CC, or both, before they can be
    anything else. Akien, 2026-08-02: "akien asks what's next? surface what's in that
    folder."

    Read straight off the directory, deliberately: this store has no device and does not
    need one. An item is unresolved iff ``resolved`` is null/absent, which is a rule the
    store's own charter states and nothing else owns — so reading it here is not a second
    owner, it is the only one. When the store grows a device this moves behind it, exactly
    as the trouble lane did.

    A malformed item counts as UNRESOLVED and says so, the same direction the trouble
    lane chose: a decision nobody can read is not a decision that got made (Law 7).
    """
    if not ADJUDICATIONS.is_dir():
        return [], None                 # not every clone has one yet; silence, not noise
    out, bad = [], []
    for p in sorted(ADJUDICATIONS.glob("*.json")):
        if p.name.startswith("_"):
            continue
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except Exception as exc:
            bad.append(f"{p.name}: {exc}")
            out.append({"id": p.stem, "what": "UNREADABLE — counts as unresolved",
                        "whose": "?", "blocks": "?"})
            continue
        if not d.get("resolved"):
            out.append(d)
    return out, ("unreadable adjudication(s): " + "; ".join(bad)) if bad else None


def _open_questions() -> tuple[list[dict], str | None]:
    """THE OPEN LANE — CC's frontier, surfaced to Akien. Akien, 2026-08-11: "open
    questions lands with you... open questions is part of what i should see from the
    hook where it says 'you still have things to decide on'."

    NOT THE SAME TIER AS THE GATE OR THE LAP, and the header says so. Those two are
    work only Akien can move. These are CC's — he owns raising them, holding them and
    checking them at every "what's next"; Akien sees the lane, he does not own it
    (Law 6, and the ruling is explicit that the surface is not the custody).

    IT SHOWS HALF THE LANE AND SAYS SO. The store's charter compiles this lane from
    TWO sources: homeless `open-*.json` here, and every charter's `filed_edges`, which
    live beside the code they bound (Law 5) and can only appear through a projector.
    That projector does not exist — and is itself already a member of the lane it is
    missing from (open-the-frontier-projector.json). A lane that showed the homeless
    half silently would be the cropped map this ruling was made against, so the count
    is labelled at the surface rather than being quietly partial.

    The `open-` prefix IS the lane boundary — the charter states it outright: "a probe
    file never wears it, an open question always does." So the glob is the membership
    rule and not a second owner of it. Unresolved iff ``resolved`` is null/absent, and
    an unreadable one counts as unresolved and says so — the same direction the trouble
    and lap lanes chose (Law 7).
    """
    if not QUESTIONS.is_dir():
        return [], None                 # not every clone has one yet; silence, not noise
    out, bad = [], []
    for p in sorted(QUESTIONS.glob("open-*.json")):
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except Exception as exc:
            bad.append(f"{p.name}: {exc}")
            out.append({"id": p.stem, "question": "UNREADABLE — counts as unresolved",
                        "raised_by": "?"})
            continue
        if not d.get("resolved"):
            out.append(d)
    return out, ("unreadable open question(s): " + "; ".join(bad)) if bad else None


def _receipt(slate: dict | None, path: Path | None, troubles: list, t_err: str | None,
             pending: list, g_err: str | None, unadj: list | None = None,
             questions: list | None = None) -> str:
    """The one line Akien sees. Carries the values that MOVE — which slate was
    chosen, how many troubles are live, and how many findings stand at his gate
    — so a wrong answer is visible at a glance. A fixed string here would be a
    receipt for having a hook, not for having read the slate."""
    which = "NO SLATE RESTORED" if slate is None else str(slate.get("id") or (path.stem if path else "?"))
    lane = "trouble lane UNREACHABLE" if t_err else f"{len(troubles)} live trouble(s)"
    gate = "gate lane UNREACHABLE" if g_err else f"{len(pending)} at the gate"
    lap = f" · {len(unadj)} in the lap" if unadj else ""
    open_q = f" · {len(questions)} open question(s)" if questions else ""
    return f"🪝 slate · {which} · {lane} · {gate}{lap}{open_q}"


def build() -> tuple[str, str]:
    """Return ``(banner, receipt)``. Split out from main so the two output shapes
    (plain text by hand, JSON under the hook) render the SAME bytes — a second
    renderer would be a second owner of what session-open says (Law 6)."""
    lines: list[str] = []

    troubles, t_err = _live_troubles()
    pending, g_err = _at_the_gate()
    unadj, a_err = _unadjudicated()
    questions, q_err = _open_questions()
    path, slate, s_warn = _newest_slate()

    lines.append(_rule("═"))
    lines.append("CAIRN — SESSION OPEN".center(WIDTH))
    lines.append(_rule("═"))

    # Troubles FIRST. A blocked thing learned about after the plan is learned too late.
    if t_err:
        lines.append(f"!! {t_err}")
        lines.append("")
    elif troubles:
        lines.append(f"!! {len(troubles)} LIVE TROUBLE(S) — these stay in the inbox until cleared:")
        for t in troubles:
            ident = t.get("id", "<no id>")
            count = t.get("count", "?")
            why = t.get("why", "<no why recorded>")
            lines.append(f"   [{count}x] {ident}")
            lines.append(_render(why, "        "))
        lines.append("")
    else:
        lines.append("   no live troubles. (the normal operating state is zero — this is it.)")
        lines.append("")

    # The gate, second — above the plan for the same reason troubles are: a finding
    # awaiting his verdict is work only HE can move, and it must not hide below the
    # slate. Zero pending prints NOTHING (the tool is invisible when it works).
    if g_err:
        lines.append(f"!! {g_err}")
        lines.append("")
    elif pending:
        lines.append(f"⚖  AT AKIEN'S GATE — {len(pending)} finding(s) awaiting his verdict:")
        for f in pending:
            lines.append(f"   [{f.get('block', '?')}] {f.get('id', '?')}"
                         f"  {str(f.get('when', ''))[:19]}")
            for b in (f.get("data") or {}).get("bullets", []):
                lines.append(_render(f"· {b.get('text', '')}", "        "))
        lines.append(_wrap('answer with: cairn recordverdict [<block-or-id>] '
                           '"<your words>"', "   "))
        lines.append("")

    # THE LAP, third — same tier as the gate and for the same reason: a thing that cannot
    # be ticketed until somebody decides it is work only a person can move. Zero prints
    # NOTHING. Akien, 2026-08-02: "akien asks what's next? surface what's in that folder."
    if a_err:
        lines.append(f"!! {a_err}")
        lines.append("")
    if unadj:
        lines.append(f"🤝 NEEDS ADJUDICATION — {len(unadj)} item(s) in the lap:")
        for a in unadj:
            lines.append(f"   [{a.get('whose', '?')}] {a.get('id', '?')}")
            lines.append(_render(a.get("what", "<no what recorded>"), "        "))
            blocks = a.get("blocks")
            if blocks:
                lines.append(_render(f"blocks: {blocks}", "        "))
        lines.append(_wrap("decide, then record `resolved` and which door it became "
                           "(IDEA / INTENT / TICKET).", "   "))
        lines.append("")

    # THE OPEN LANE, fourth — below the two lanes that are HIS and above the plan,
    # because a next step chosen without reading the open frontier is chosen against a
    # map with its edges cropped off (Akien, 2026-08-11). Zero prints NOTHING.
    if q_err:
        lines.append(f"!! {q_err}")
        lines.append("")
    if questions:
        lines.append(f"❓ OPEN QUESTIONS — {len(questions)} standing (CC owns these; "
                     f"this lane is so you can see them):")
        for q in questions:
            lines.append(f"   [{q.get('raised_by', '?')}] {q.get('id', '?')}")
            lines.append(_render(q.get("question", "<no question recorded>"), "        "))
        lines.append(_wrap("CC checks these FIRST at every 'what's next', and files a new "
                           "one for every 'to be clear, I did not do X'.", "   "))
        lines.append(_wrap("SHOWING HALF THE LANE: homeless open-*.json only. The "
                           "charters' filed_edges need a projector that does not exist "
                           "yet (open-the-frontier-projector).", "   "))
        lines.append("")

    if slate is None:
        lines.append(f"!! NO SLATE RESTORED: {s_warn}")
        lines.append("   Opening cold. Orient from MAP.md.")
        lines.append(_rule("═"))
        return "\n".join(lines), _receipt(None, None, troubles, t_err, pending, g_err, unadj, questions)

    if s_warn:
        lines.append(f"!! {s_warn}")
        lines.append("")

    lines.append(f"SLATE  {slate.get('id', path.stem)}")
    lines.append(f"       {slate.get('date', '?')}   author: {slate.get('author', '?')}   file: {path.name}")
    lines.append("")

    for field in CARRIED:
        if field not in slate:
            lines.append(f"{field.upper()}:")
            lines.append("  (absent from this slate)")
            lines.append("")
            continue
        lines.append(f"{field.upper()}:")
        lines.append(_render(slate[field]))
        lines.append("")

    lines.append(_rule())
    lines.append(_wrap(
        "Every line above is a POINTER TO VERIFY, not a proof (Law 3). The slate is "
        "authoritative for session continuity; MAP.md is authoritative over memory of "
        "the conversation. Drift between them is NAMED, never silently reconciled — "
        "that check is yours, it did not compile.", ""))
    lines.append(_rule("═"))

    return "\n".join(lines), _receipt(slate, path, troubles, t_err, pending, g_err, unadj, questions)


def main(argv: list[str]) -> int:
    banner, receipt = build()
    if HOOK_FLAG in argv:
        # One object, both audiences. additionalContext is what stdout used to be.
        print(json.dumps({
            "systemMessage": receipt,
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": banner,
            },
        }, ensure_ascii=False))
    else:
        print(banner)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:                # never wedge session open (see module docstring)
        # Under the hook, stderr goes nowhere Akien will look and an empty stdout is
        # SILENT — the exact failure this program exists to end. Pay the receipt out
        # of the crash path too, so a broken slate announces itself to its owner.
        if HOOK_FLAG in sys.argv[1:]:
            print(json.dumps({"systemMessage": f"🪝 slate FAILED: {type(exc).__name__}: {exc}"},
                             ensure_ascii=False))
        print(f"!! cairn slate failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(0)
