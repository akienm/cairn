# Shell scripts run under Git Bash on Windows; CRLF breaks them. LF in the working tree.
bin/cairn text eol=lf
bin/cmd/* text eol=lf
bin/logger_for_bash text eol=lf
cairn/devices/recovery/*.sh text eol=lf
cairn/devices/cc/superclaude text eol=lf
*.sh text eol=lf
cairn/devices/**/bin/* text eol=lf
*.cmd text eol=crlf

# Records are byte-exact artifacts (the artifact door canonical form): LF everywhere, never autocrlf.
*.json text eol=lf
*.jsonl text eol=lf

# Source is LF on every box (ticket 88e30cde9bd4): the validation store's fingerprint hashes raw
# working-tree bytes, so a CRLF checkout could never match the Linux seal of the same commit.
# Measured 2026-11-12: the same 3-file closure hashes a614f1bf... CRLF and 9236ec0d... LF (= Linux).
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf

# The tracked pre-commit hook source has no extension, so no glob above reaches it; install_hook
# copies it into .git/hooks and a shell runs it (ticket daaf7ac3e4ec).
cairn/devices/tester/hooks/pre-commit text eol=lf

# The artifact journal meets another branch re-linked, never forked (ticket b7d2e05a1c93);
# the driver is installed per box: cairn artifact install-merge-driver <root>.
.artifact-journal.jsonl merge=cairn-journal
