#!/usr/bin/env bash
# superclaude — Cairn's Claude Code launcher.
#
# Canonical home: cairn/launchers/superclaude  (symlinked onto PATH via ~/.local/bin;
# a convenience pointer also sits at the repo root: cairn/superclaude).
# Charter + why: cairn/launchers/intention+why.json
#
# ── WHAT ─────────────────────────────────────────────────────────────────────
# Launches Claude Code with Cairn's standing session contract:
#   - session name       <hostname>_cc_0   (singleton = instance 0, not a special case)
#   - remote control      on, same name
#   - permission prompts   bypassed (dangerous — a trusted local dev box)
#   - context window       a two-state switch (1M / 200K); see the WHY below
# Every other argument is forwarded to `claude` untouched.
#
# ── WHY the context switch is built the way it is ────────────────────────────
# (This was learned the hard way: the quarry's launcher had this exact logic but
#  NOT its why written down, so it got misread. The why lives here now.)
#
# It is a switch with TWO states, and THE COMMAND LINE ALWAYS WINS:
#   * Big design work wants 1M — opt up with --1m.
#   * Heavy buildout (lots of small tickets) defaults to 200K. The real why, stronger
#     than mere convenience: Claude cannot self-trigger /compact, so at 1M the context
#     balloons past Akien's notification threshold before he is alerted. Defaulting to
#     200K makes stewardship of resources a property of the system (physics, Law 4), not
#     of anyone remembering to pass --200k (discipline). Flipping the built-in default is
#     a one-line edit (FILE_DEFAULT_200K), currently 1 = 200K.
#   * --1m  opts UP: it *unsets* any 200K constraint, so it wins even over a 200K
#           environment. (unset, NOT =0 — the disable var only ever turns 1M OFF;
#           =0 is a no-op that merely looks like it worked.)
#   * --200k opts DOWN: it imposes the 200K constraint.
#   * If nothing decides — no flag, no environment var, no file default — it launches
#     UNCONSTRAINED (1M). Precedence, highest first: command line > environment > file
#     default > unconstrained.
#
# NOTE (measured caveat): docs say an unset constraint makes 1M *available*, while
# the [1m] model variant is what *selects* it. Empirically, unset yields 1M in this
# environment (the session that wrote this file was 1M). If a --1m launch ever comes
# up 200K, that's the signal to also point the model at a [1m] variant — set
# SUPERCLAUDE_1M_MODEL and export ANTHROPIC_DEFAULT_OPUS_MODEL below. Not before.
#
# NOT set -e: from here to `exec claude`, nothing may abort the launch — the prime
# directive is to always reach Claude Code so it can help rebuild a broken box.
set -uo pipefail

# ── FILE DEFAULT — edit THIS ONE LINE to flip the built-in default ───────────
# Applies only when neither the environment nor the command line decides.
#   0 = no file constraint  → unconstrained (1M) when the env is silent  [big-design default]
#   1 = default to 200K     → 200K when the env is silent               [small-ticket default]
FILE_DEFAULT_200K=1

show_help() {
  cat <<'HELP'
superclaude — Cairn's Claude Code launcher.

  Standing contract (always applied):
    --name <hostname>_cc_0              stable singleton session name
    --remote-control <hostname>_cc_0    remote control on, same name
    --dangerously-skip-permissions      bypass permission prompts

  Context window — a two-state switch; the command line always wins:
    --1m            opt UP: unset any 200K constraint (wins over a 200K environment)
    --200k, --no-1m opt DOWN: impose the 200K constraint
    (neither)       inherit the environment; if it's silent, the file default; if
                    that's silent too, launch unconstrained (1M)

  Launcher-only:
    --dry-run       print the resolved context state + claude command, do not launch
    --no-preflight  skip the floor check entirely (rescue hatch: use if the preflight
                    itself is what's broken — the launch must always be reachable)
    -h, --help      this message

  Preflight — superclaude gets itself started (cairn/launchers/bootstrap.sh):
    Brings up the venv + editable install so `cairn` imports from anywhere, then
    hands Claude a report of whatever it could NOT fix, so the session opens already
    knowing. Silent when the floor is up. It can never abort the launch.

  Flip the built-in default by editing FILE_DEFAULT_200K in this file.
  All other arguments are forwarded to `claude` unchanged, e.g.:
    superclaude --1m --model claude-opus-4-8
HELP
}

# ── parse OUR flags; forward everything else ─────────────────────────────────
want_1m=0
want_200k=0
dry_run=0
no_preflight=0
pass=()
for arg in "$@"; do
  case "$arg" in
    --1m)            want_1m=1 ;;
    --200k|--no-1m)  want_200k=1 ;;
    --dry-run)       dry_run=1 ;;
    --no-preflight)  no_preflight=1 ;;
    -h|--help)       show_help; exit 0 ;;
    *)               pass+=("$arg") ;;
  esac
done

# ── resolve the context switch (command line > environment > file > unconstrained)
# The state variable IS Claude Code's own control var, CLAUDE_CODE_DISABLE_1M_CONTEXT.
context_state=""   # for --dry-run reporting: "1M" | "200K"
if [[ "$want_1m" -eq 1 ]]; then
  unset CLAUDE_CODE_DISABLE_1M_CONTEXT 2>/dev/null || true       # --1m wins: unconstrained
  context_state="1M (command line --1m)"
elif [[ "$want_200k" -eq 1 ]]; then
  export CLAUDE_CODE_DISABLE_1M_CONTEXT=1                        # --200k wins: 200K
  context_state="200K (command line --200k)"
elif [[ -n "${CLAUDE_CODE_DISABLE_1M_CONTEXT:-}" ]]; then
  # environment already decided — leave it exactly as inherited
  [[ "$CLAUDE_CODE_DISABLE_1M_CONTEXT" == "1" ]] \
    && context_state="200K (environment)" \
    || context_state="1M (environment)"
elif [[ "$FILE_DEFAULT_200K" -eq 1 ]]; then
  export CLAUDE_CODE_DISABLE_1M_CONTEXT=1                        # file default: 200K
  context_state="200K (file default)"
else
  context_state="1M (unconstrained — nothing decided)"          # nothing said → unconstrained
fi

# ── session identity: <hostname>_cc_0 ────────────────────────────────────────
host=$(hostname | cut -d. -f1 | tr '[:upper:]' '[:lower:]')
session="${host}_cc_0"

# ── preflight: get ourselves started ─────────────────────────────────────────
# "Launch with as many of the things as you can already working" (Akien, 2026-07-30) —
# then TELL CLAUDE what you couldn't fix, so the tool is invisible when it works and
# actionable when it doesn't. Anything the launcher silently swallows becomes tokens
# some future session spends re-deriving; that is the defect this whole block exists for.
#
# THE PRIME DIRECTIVE STILL RULES. Nothing here may abort the launch: the bootstrap sets
# no -e, every call is guarded, and each branch falls through to exec. A broken preflight
# must still deliver Claude Code to a broken box — that is the tier's entire purpose.
#
# IT ALSO KEEPS THE FLIGHT RECORDER (the WATCHME probe). Booting is exactly the situation
# where nothing else is up yet to observe you, so the launcher observes itself: what it
# tried, what came back, what it could not fix, into ~/.cairn/logs/boot. superclaude is a
# CHILD PROCESS, so exporting the namespace here scopes it to this launch and leaves the
# calling shell's own log untouched — the "a new process renames the namespace until it
# completes" property, which costs nothing because it is just how export works.
export CAIRN_LOGTARGET="${CAIRN_BOOT_LOG:-$HOME/.cairn/logs/boot}"
_sc_log() { declare -F lognote >/dev/null 2>&1 && lognote "$@"; return 0; }

# Sourced OUTSIDE the preflight branch on purpose. --no-preflight is the rescue hatch, and
# a launch that used it is the single most interesting line this probe can capture: it means
# the floor check got broken enough that someone routed around it. Recording only the
# launches that took the happy path would make the probe blind to its own failure mode.
_sc_logger="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../bin/logger_for_bash"
if [[ -r "$_sc_logger" ]]; then
  # shellcheck source=/dev/null
  source "$_sc_logger" 2>/dev/null || true
fi
_sc_log "launch: argv=[$*] session=$session context=$context_state preflight=$([[ "$no_preflight" -eq 1 ]] && echo bypassed || echo on)"

preflight_arg=()
if [[ "$no_preflight" -eq 0 ]]; then
  bootstrap="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/bootstrap.sh"
  if [[ -r "$bootstrap" ]]; then
    # shellcheck source=/dev/null
    source "$bootstrap" || true
    if declare -F cairn_bootstrap_verify >/dev/null 2>&1; then
      # verify first: the warm path is ~90ms and does no work. apply only on a real miss,
      # so the common launch pays a rounding error rather than a pip run (Law 1 — the
      # settled floor is not re-derived on every launch).
      preflight_t0="${EPOCHREALTIME:-0}"
      cairn_bootstrap_verify >/dev/null 2>&1 || cairn_bootstrap_apply >/dev/null 2>&1 || true
      # The venv goes on PATH ahead of system python, so `python3` inside the session IS
      # the floor we just laid. Without this the session would still reach system python
      # and the whole preflight would be theatre.
      venv_bin="$(cairn_venv_dir)/bin"
      [[ -d "$venv_bin" ]] && export PATH="$venv_bin:$PATH"
      residue="$(cairn_bootstrap_report 2>/dev/null)" || true
      [[ -n "$residue" ]] && preflight_arg=(--append-system-prompt "$residue")
      # The cost, every launch, in the record — so "the preflight got slow" is a thing
      # someone can SEE rather than suspect. A tool that is invisible when it works has
      # to prove it stayed cheap, or invisible eventually means unaccountable.
      _sc_log "preflight: done in $(awk -v a="${EPOCHREALTIME:-0}" -v b="$preflight_t0" \
        'BEGIN{printf "%.0f", (a-b)*1000}' 2>/dev/null)ms · residue=$([[ -n "$residue" ]] && echo yes || echo none)"
    fi
  else
    # Loud, never silent (CP1) — but still not fatal.
    echo "superclaude: preflight skipped — bootstrap.sh not readable at $bootstrap" >&2
    _sc_log "preflight: SKIPPED — bootstrap.sh not readable at $bootstrap"
  fi
else
  _sc_log "preflight: skipped by --no-preflight"
fi

# ── assemble the launch ──────────────────────────────────────────────────────
claude_bin="${CLAUDE_BIN:-claude}"
set -- \
  --name "$session" \
  --remote-control "$session" \
  --dangerously-skip-permissions \
  ${preflight_arg[@]+"${preflight_arg[@]}"} \
  ${pass[@]+"${pass[@]}"}

# The last line before the shell is replaced. If a launch ever vanishes without reaching
# Claude Code, this is the line that says how far it got — and the prime directive says it
# always should, so a boot log whose last entry is not `exec:` is a defect with a timestamp.
# Rendered with %q rather than interpolated: the argv can carry a whole multi-line
# preflight report, and the point of this line is that it can be pasted back and re-run.
if declare -F _logbash_render >/dev/null 2>&1; then
  _sc_log "exec: $(_logbash_render "$claude_bin" "$@")"
else
  _sc_log "exec: $claude_bin $*"
fi

if [[ "$dry_run" -eq 1 ]]; then
  echo "# superclaude --dry-run"
  echo "# context: $context_state"
  echo "# CLAUDE_CODE_DISABLE_1M_CONTEXT=${CLAUDE_CODE_DISABLE_1M_CONTEXT:-<unset>}"
  printf 'exec %s' "$claude_bin"
  printf ' %q' "$@"
  echo
  exit 0
fi

exec "$claude_bin" "$@"
