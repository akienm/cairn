#!/usr/bin/env bash
# cairn determinism — what each component's shipped import path can reach.
#
# A thin registration against the tool, matching bin/cmd/ruling and bin/cmd/test: resolve
# the interpreter, hand off, keep the exit code. It owns no logic about what it runs (Law 6).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"       # bin/cmd -> bin -> repo root (where the cairn package is)

# Same interpreter resolution as the sibling doors: outside a superclaude session the venv
# is not on PATH, so bare python3 is system python and cannot import cairn.
BOOTSTRAP="$REPO/launchers/bootstrap.sh"
PY="python3"
if [[ -r "$BOOTSTRAP" ]]; then
  # shellcheck source=/dev/null
  source "$BOOTSTRAP" && PY="$(cairn_python)"
fi

cd "$REPO"
exec "$PY" -m cairn.tools.determinism.determinism "$@"
