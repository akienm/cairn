#!/usr/bin/env bash
# cairn trouble live — what is still demanding attention (--json for machines)
#
# Moved verbatim from the launcher's case arm (ticket 285a8f3f7599): a word with a script in
# the device's bin runs it, else the line goes onto the bus (Q#27, outline 8.4). It is trouble's
# OWN code, so it reads the store as files through tools/store/ and never asks trouble over the
# bus (ticket ee04bb869795).
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"/../../../../.. && pwd)"

exec python3 -c "
import sys, json; sys.path.insert(0, '$REPO_ROOT')
from cairn.devices.trouble.shim import TroubleShim
from cairn.devices.trouble.tools.store import store

as_json = '--json' in sys.argv[1:]
# The owner folds what is pending before the read answers, in this process (as drain does).
TroubleShim().drain()
try:
    troubles = store.live()
except FileNotFoundError as exc:
    # NOT an empty list. 'there is no store' and 'nothing is wrong' are the two readings a
    # silent green confuses, and they are opposites (Law 7).
    print(f'trouble store unreadable: {exc}', file=sys.stderr)
    sys.exit(1)
if as_json:
    print(json.dumps(troubles, indent=2))
    sys.exit(0)
if not troubles:
    print('no live troubles.')
    sys.exit(0)
whole = {t.get('id'): t for t in store.listing(store.store_root())}
print(f'{len(troubles)} live trouble(s):')
for t in troubles:
    print()
    print(f\"  [{t.get('count', '?')}x] {t.get('id', '?')}   ({t.get('standing', '?')})\")
    print(f\"        {t.get('why', '')}\")
    print(f\"        first {t.get('first_seen', '?')}  last {t.get('last_seen', '?')}\")
    w = whole.get(t.get('id')) or {}
    done = {c.get('by') for c in w.get('cleared_by') or [] if isinstance(c, dict)}
    told = [r for r in w.get('notified') or [] if r not in done]
    if told:
        print(f\"        awaiting clear from: {', '.join(told)}\")
" "$@"
