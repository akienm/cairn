#!/usr/bin/env python3
"""cairn askscan — the Stop-hook scan for the prebuild-feedback signal.

THE RULE IT MEASURES (Akien, 2026-08-13, naming it the highest-value change):

    "if you're asking me clarifying questions AFTER prebuild has run, that means
     there wasn't the right info going in and that does need to become feedback.
     And so if there are going to be changes from this conversation for your side,
     it should be that."

RULED 2026-08-14, and it is the half that decides this file's whole shape:

    "each ruling packet issued at build time needs to feed back, but it does not
     need to stop the work."   ...   "i agree about #2 as well. it still should
     not stop the work, but yes, we wanna capture that."

So this CAPTURES and NEVER BLOCKS. There is no ``decision`` key anywhere below —
only ``systemMessage`` and an appended ledger row. A scan that halted the turn
would be spending the thing the feedback exists to protect.

WHAT THE SIGNAL ACTUALLY IS. The prebuild chain (the builder's machines: orient,
constrain, survey, decompose, triage, hypothesize, validate, verdict) exists to
put the right information in front of the build BEFORE it starts. If I then have
to ask Akien a design question, the chain did not carry what it was supposed to.
That is not a defect in the answer — the question may be a fine one — it is a
measurement of a GAP IN THE CHAIN'S INTAKE, and it is the chain that should learn
from it.

TWO CONDITIONS, BOTH REQUIRED, AND THE SECOND DOES THE REAL WORK. A question
alone is nothing: 33% of my end_turns carry one and most are sequencing, which is
Akien's call to make and not a defect at all. What makes a question EVIDENCE is
that a prebuild chain had already run. The temporal correlation is the
discriminator no lexical class could be — and it is the reason this scan is
narrow where turnscan is broad.

MEASURED BEFORE BUILT (Law 3), 2026-08-14, over the whole prebuild era
(2026-07-28 .. 2026-08-12: 318 packets across 8 stages and 43 tickets, 442
end_turn messages):

    question-bearing end_turns in the era ............ 82  (18.6%)
    ... within 2h of a prebuild packet ............... 18
        of those, SEQUENCING (his call, not a defect)  10
        of those, CLARIFYING (the signal) .............. 8

The eight are what the rule describes, and the two closest — 214s and 284s after
a ``verdict`` packet — are unmistakable: *"what re-runs a proof when a ruling
changes the contract it tests?"* and *"how should the chat surface present 'ask
me again'?"*. Both are design facts the chain should have carried in. Re-run the
numbers any time with ``--corpus``; that is the falsifier, and it stays runnable.

WHY SEQUENCING IS SUBTRACTED RATHER THAN COUNTED. "Want me to do that now, or
sail X first?" asks Akien to pick an ORDER, and ordering is explicitly his (he
gets bounds, sequencing, and spec-changing rulings; a design DETAIL goes to the
question corpus). Counting those would red the one kind of question the system
WANTS me to ask, and a detector that punishes correct behaviour gets turned off.
The class is lexical and therefore a floor: it keys on the question naming ME as
the actor, or asking for a direction pick.

THE FLOOR, NOT THE CEILING — the same honest limit turnscan records. This is the
code stratum: a question shape, a subtraction, and a time window. It cannot tell
a design question from a rhetorical one, and it never will. It names the gap; it
does not judge whether the question was right to ask, and it does not claim the
prebuild chain was wrong. Law 3: that is evidence, not a verdict.

THE WINDOW IS A PROXY AND IS RECORDED AS ONE. "Prebuild has run FOR THIS WORK" is
the real condition; "a prebuild packet was written in the last two hours" is what
disk can answer today. Every row carries ``gap_seconds`` and the packet it keyed
on, so a reader can tighten the window after the fact instead of trusting mine.
When a run carries a session id, this correlation retires in favour of it.

    echo '{"last_assistant_message":"..."}' | bin/cmd/askscan   # hook mode
    bin/cmd/askscan --corpus                                    # re-measure
    bin/cmd/askscan --report                                    # the ledger so far
    python3 bin/proofs/test_askscan.py                          # exit 0 = green
"""

from __future__ import annotations

import bisect
import datetime as dt
import glob
import json
import os
import re
import sys

# ── the window ────────────────────────────────────────────────────────────────
# Two hours. Chosen from the measurement above, where 7 of the 18 hits landed
# within 30 minutes, 14 within an hour, and 18 within two. Widening it is cheap
# because a false positive costs one printed line and one ledger row and NEVER a
# stop; narrowing it after the fact costs nothing either, because gap_seconds
# rides in every row.
WINDOW_SECONDS = 7200

# A question shorter than this carries no design content. Measured: it is what
# separates "?" and "by line?" — fragments the tail splitter picked up mid-thought
# — from the real asks, the shortest of which runs well past it.
MIN_QUESTION = 25

# How much of the turn's end is treated as "the ask". A question buried in the
# middle of a long report is usually rhetorical scaffolding; the real one closes.
TAIL = 1500

# ── the subtraction: sequencing is HIS to answer, and is not the defect ───────
SEQUENCING = [
    r"^want me to\b",
    r"^do you want\b",
    r"^would you (like|rather)\b",
    r"^should i\b",
    r"^shall i\b",
    r"^which\b",
    r"^where (do|to) (you|go)\b",
    r"^what would you like\b",
    r"^ready\b",
    r"^(sorted )?approved\b",
    r"\bnow,? or\b",
    r"\bfirst,? or\b",
]
_SEQUENCING = [re.compile(p, re.I) for p in SEQUENCING]

# Quoted material is not an utterance — the same lesson turnscan paid for, and it
# bites harder here: this file's own docstring quotes two questions verbatim.
QUOTE_MAX = 240


def strip_quoted(text: str) -> str:
    """Remove mention so only use is scanned.

    INLINE CODE IS UNWRAPPED, NOT BLANKED, and that distinction was measured, not
    reasoned. Blanking it cost the capture half its legible rows: three of the six
    reds over the whole prebuild era came out clipped —
    ``"how should the chat surface present ?"`` — because the noun the question was
    ABOUT sat in backticks and the stripper ate it. A technical question is exactly
    the kind that names an identifier, so the lossiest rows were the ones most worth
    processing, and a row Akien cannot read is a row nobody can attribute to a stage.
    A whole question rarely fits inside single backticks; a MENTIONED one is fenced
    or quoted, and both of those still blank. So the backticks go and the words stay.
    """

    def blank(m: re.Match) -> str:
        return " " * len(m.group(0))

    text = re.sub(r"```.*?```", blank, text, flags=re.S)
    text = re.sub(r"`([^`\n]*)`", lambda m: " " + m.group(1) + " ", text)
    text = re.sub(r"^\s*>.*$", blank, text, flags=re.M)
    # A QUOTED TERM IS USE; A QUOTED QUESTION IS MENTION. The stripper exists to stop
    # this scan reddening every turn that DISCUSSES a clarifying question — and that
    # hazard is a quoted question, which ends in a mark. A quoted NOUN inside a live
    # question is the thing being asked about, and blanking it gutted a real row the
    # same way the backticks did: "how should the chat surface present ?". So the test
    # is the question mark inside the quotes, not the quotes.
    def unwrap(m: re.Match) -> str:
        inner = m.group(1)
        return blank(m) if inner.rstrip().endswith(("?", "!")) else " " + inner + " "

    for pair in ('"([^"\n]{1,%d})"', '“([^”\n]{1,%d})”', '‘([^’\n]{1,%d})’'):
        text = re.sub(pair % QUOTE_MAX, unwrap, text)
    return text


def _clean(q: str) -> str:
    """A question sentence without its markdown furniture, for matching only."""
    return re.sub(r"\s+", " ", re.sub(r"[*#>_`\[\]]", "", q)).strip()


def asked(message: str) -> dict | None:
    """The clarifying question this turn ends on, or None.

    Returns the LAST one: when a turn asks several, the closing question is the
    one Akien answers, and counting all of them would weight a single gap by how
    talkative the turn was.
    """
    if not message or not message.strip():
        return None
    tail = strip_quoted(message)[-TAIL:]
    # A SENTENCE ENDS WHERE THE NEXT ONE STARTS, not at every period. The naive
    # boundary split a parenthetical — "(by seq? by age? by size?)" — into three, and
    # the last fragment is what survived: "by size?)", a row nobody can act on. It
    # broke on "e.g. " the same way. Requiring a real sentence opener after the mark
    # keeps the question whole, which is the whole point of capturing it.
    for raw in reversed(re.split(r"(?<=[.?!])\s+(?=[A-Z0-9(\-*#])|\n{2,}", tail)):
        q = _clean(raw)
        if not q.endswith("?") or len(q) < MIN_QUESTION:
            continue
        seq = next((p.pattern for p in _SEQUENCING if p.search(q)), None)
        if seq:
            # Named and dropped, not silently skipped: a subtraction nobody can
            # see is a subtraction nobody can argue with.
            return {"question": q, "sequencing": seq, "clarifying": False}
        return {"question": q, "sequencing": None, "clarifying": True}
    return None


# ── the second condition: had the prebuild chain run? ─────────────────────────
# Instance-space, and read-only from here. The scan never writes into a packet
# folder's packets/ — it appends beside them, at the instance that owns the run.
#
# RESOLVED THROUGH HOME, AND THAT IS LOAD-BEARING, NOT COSMETIC. A test that wants
# to fire this scan FOR REAL — which tooth 1 must, because "it never blocks" is a
# claim about the process, not about a function — otherwise fires it at the live
# instance and appends a fixture row to the production ledger. That is exactly what
# happened: 15 of the first 19 rows were written by ``bin/proofs/test_askscan.py``,
# a question that appears in no transcript as anything anyone ever said. Instance
# space is rooted at HOME, so a subprocess given a different HOME gets a different
# instance, and the isolation costs one env var instead of an injection seam.
BERTHS = os.path.expanduser("~/.cairn/devices/chart")
LEDGER = "prebuild-gaps.jsonl"
STAGES = ("orient", "constrain", "survey", "decompose", "triage",
          "hypothesize", "validate", "verdict")


def prebuild_runs(berths: str = BERTHS) -> list[tuple[float, str, str]]:
    """(mtime, stage, path) for every prebuild packet on disk, oldest first.

    MTIME, NOT THE FILENAME STAMP. The filename carries local time and the
    transcript carries UTC, and reconciling two clocks by parsing is how an
    off-by-one-timezone bug hides for a season. st_mtime is one number in one
    frame, and it is the number both sides can be compared in.
    """
    out = []
    for path in glob.glob(os.path.join(berths, "*", "packets", "*.json")):
        stage = os.path.basename(path).split("-")[0]
        if stage not in STAGES:
            continue
        try:
            out.append((os.stat(path).st_mtime, stage, path))
        except OSError:
            continue          # a packet that vanished mid-walk is not a finding
    out.sort()
    return out


def last_run_before(when: float, runs: list[tuple[float, str, str]]):
    """The most recent prebuild packet at or before ``when``, or None."""
    i = bisect.bisect_right([r[0] for r in runs], when)
    return runs[i - 1] if i else None


def gap(message: str, when: float, runs=None, window: int = WINDOW_SECONDS) -> dict | None:
    """The whole signal: a clarifying question, and a prebuild run behind it.

    Returns the evidence, or None. Both conditions are required and the reason is
    in the docstring above — a question with no run behind it is an ordinary
    question, and a run with no question is prebuild working.
    """
    ask = asked(message)
    if not ask or not ask["clarifying"]:
        return None
    runs = prebuild_runs() if runs is None else runs
    prev = last_run_before(when, runs)
    if not prev:
        return None
    elapsed = when - prev[0]
    if elapsed > window:
        return None
    return {
        "at": dt.datetime.fromtimestamp(when, dt.timezone.utc).isoformat(),
        "question": ask["question"],
        "gap_seconds": int(elapsed),
        "after_stage": prev[1],
        "after_packet": os.path.basename(prev[2]),
        "packet_path": prev[2],
        "window_seconds": window,
    }


def receipt(g: dict) -> str:
    return (f"◇ prebuild-feedback: a clarifying question {g['gap_seconds']}s after "
            f"{g['after_stage']} — \"{g['question'][:110]}\". The chain did not carry "
            "that in. Captured, not blocking; the work continues.")


def record(g: dict) -> str | None:
    """Append the gap beside the run it keys on, and return where it landed.

    THE OWNER OF THE FEEDBACK IS THE CHAIN THAT LEAKED IT, so the row lands in the
    instance folder holding the packet — not in a central collection somewhere
    else. Append-only, one JSON object per line; nothing here ever rewrites.
    """
    try:
        instance = os.path.dirname(os.path.dirname(g["packet_path"]))
        path = os.path.join(instance, LEDGER)
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(g, ensure_ascii=False) + "\n")
        return path
    except OSError as exc:
        # Loud on the diagnostic surface, never fatal: a ledger that cannot be
        # written is worth saying out loud and is not worth wedging a turn over.
        print(f"askscan: could not record the gap: {exc}", file=sys.stderr)
        return None


# ── retraction: how an APPEND-ONLY ledger corrects itself ─────────────────────
# A ledger that can be edited is not a record, so the 15 contaminated rows are not
# deleted and never will be. A correction is another ROW — one that names what it
# retracts and why — and the reader applies it. This is the same shape as the
# sequencing subtraction one stratum up: the subtraction is visible, so it can be
# argued with. A retraction nobody can see is indistinguishable from a hand quietly
# tidying the evidence.
#
# THE DOOR REFUSES A RETRACTION THAT RETRACTS NOTHING. "These rows are junk" is a
# claim about what is on disk, and a claim that matches zero rows is false — it
# would sit in the ledger forever looking like a correction that had been applied.

def _ledger_paths(berths: str = BERTHS) -> list[str]:
    return sorted(glob.glob(os.path.join(berths, "*", LEDGER)))


def _rows(path: str) -> list[dict]:
    out = []
    try:
        for line in open(path, encoding="utf-8"):
            if line.strip():
                try:
                    out.append(json.loads(line))
                except Exception:
                    continue      # an unreadable line is not a gap and not a crash
    except OSError:
        pass
    return out


def apply_corrections(rows: list[dict]) -> tuple[list[dict], list[dict], list[dict]]:
    """Split a ledger's rows into (standing gaps, retracted gaps, corrections).

    A gap is retracted when some correction in the SAME ledger names its question
    verbatim and was written after it. Verbatim, because a substring rule would let
    one correction silently swallow rows nobody inspected.
    """
    corrections = [r for r in rows if "retracts" in r]
    gaps = [r for r in rows if "retracts" not in r]
    standing, retracted = [], []
    for g in gaps:
        hit = next((c for c in corrections
                    if c["retracts"].get("question") == g.get("question")
                    and g.get("at", "") <= c["retracts"].get("before", "")), None)
        (retracted if hit else standing).append(g)
    return standing, retracted, corrections


def retract(packet: dict, berths: str = BERTHS) -> dict:
    """Append a correction row to every ledger holding a matching gap.

    ``packet`` carries ``question`` (verbatim), ``reason``, ``authority``, and
    optionally ``before`` (default: now — a correction never reaches forward over
    rows that have not been written yet, which is what makes it safe to leave
    standing).
    """
    for field in ("question", "reason", "authority"):
        if not str(packet.get(field, "")).strip():
            raise ValueError(
                f"retract: '{field}' is required and must say something — a correction "
                f"without a reason is a row that deletes evidence and explains nothing")
    before = packet.get("before") or dt.datetime.now(dt.timezone.utc).isoformat()
    row = {"retracts": {"question": packet["question"], "before": before},
           "reason": packet["reason"], "authority": packet["authority"],
           "at": dt.datetime.now(dt.timezone.utc).isoformat()}
    written, matched = [], 0
    for path in _ledger_paths(berths):
        standing, _, _ = apply_corrections(_rows(path))
        n = sum(1 for g in standing
                if g.get("question") == packet["question"] and g.get("at", "") <= before)
        if not n:
            continue
        matched += n
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + "\n")
        written.append(path)
    if not matched:
        raise ValueError(
            "retract: that question matches no STANDING gap on any ledger — a "
            "retraction that retracts nothing is a false claim about the record, and "
            "it would sit there forever looking like a correction that had been applied")
    return {"retracted": matched, "ledgers": written, "row": row}


# ── corpus mode: the falsifier, kept re-runnable ──────────────────────────────

DEFAULT_CORPUS = os.path.expanduser("~/.claude/projects/-home-akien-dev-src-cairn/*.jsonl")


def corpus(pattern: str) -> int:
    files = sorted(glob.glob(pattern))
    if not files:
        print(f"no transcripts matched {pattern}", file=sys.stderr)
        return 1
    runs = prebuild_runs()
    if not runs:
        print("no prebuild packets on disk — the second condition cannot be met, so "
              "this scan is structurally silent, not clean", file=sys.stderr)
        return 1
    era = runs[0][0]
    turns = in_era = with_q = seq = 0
    hits = []
    for f in files:
        for line in open(f, encoding="utf-8", errors="replace"):
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("type") != "assistant":
                continue
            m = d.get("message", {})
            if m.get("stop_reason") != "end_turn":
                continue
            txt = "\n".join(b.get("text", "") for b in m.get("content", [])
                            if isinstance(b, dict) and b.get("type") == "text")
            ts = d.get("timestamp", "")
            if not txt.strip() or not ts:
                continue
            turns += 1
            when = dt.datetime.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S").replace(
                tzinfo=dt.timezone.utc).timestamp()
            if when < era:
                continue
            in_era += 1
            ask = asked(txt)
            if not ask:
                continue
            with_q += 1
            if not ask["clarifying"]:
                seq += 1
                continue
            g = gap(txt, when, runs=runs)
            if g:
                hits.append((os.path.basename(f)[:8], g))
    print(f"{len(files)} transcript(s)   {turns} end_turn message(s)")
    print(f"{in_era} in the prebuild era (since "
          f"{dt.datetime.fromtimestamp(era).strftime('%Y-%m-%d %H:%M')}), "
          f"{len(runs)} packet(s) on disk")
    pct = (100.0 * with_q / in_era) if in_era else 0.0
    print(f"{with_q} ended on a question ({pct:.1f}%)  —  {seq} sequencing (his call, "
          f"subtracted), {with_q - seq} clarifying")
    print(f"{len(hits)} red: clarifying, within {WINDOW_SECONDS}s of a prebuild run")
    for src, g in sorted(hits, key=lambda h: h[1]["gap_seconds"]):
        print(f"\n  {src}  +{g['gap_seconds']}s after {g['after_stage']}")
        print(f"    {g['question'][:170]}")
    return 0


def report(berths: str = BERTHS, show_retracted: bool = False) -> int:
    """Every STANDING gap, oldest first, with the retracted ones counted apart.

    Attendance, not only objections: the packet count says how many chances there
    were to leak one. And the retracted count is printed even when it is zero,
    because a corrected ledger that reads exactly like an uncorrected one is a
    ledger whose corrections nobody can audit.
    """
    runs = prebuild_runs(berths)
    standing, retracted, corrections = [], [], []
    for path in _ledger_paths(berths):
        s, r, c = apply_corrections(_rows(path))
        standing += s
        retracted += r
        corrections += c
    standing.sort(key=lambda r: r.get("at", ""))
    print(f"prebuild-feedback ledger — {len(standing)} standing gap(s) over "
          f"{len(runs)} prebuild packet(s); {len(retracted)} retracted by "
          f"{len(corrections)} correction(s)")
    for r in standing:
        src = r.get("source")
        tag = f"  [{src}]" if src else ""
        print(f"  {r.get('at','')[:19]}  +{r.get('gap_seconds')}s after "
              f"{r.get('after_stage')}{tag}\n    {r.get('question','')[:170]}")
    for c in sorted(corrections, key=lambda r: r.get("at", "")):
        print(f"\n  correction {c.get('at','')[:19]} by {c.get('authority')}\n"
              f"    retracts: {c['retracts'].get('question','')[:110]}\n"
              f"    because:  {c.get('reason','')[:300]}")
    if show_retracted:
        for r in sorted(retracted, key=lambda r: r.get("at", "")):
            print(f"  RETRACTED {r.get('at','')[:19]}  +{r.get('gap_seconds')}s after "
                  f"{r.get('after_stage')}")
    return 0


def main(argv: list[str]) -> int:
    if "--corpus" in argv:
        i = argv.index("--corpus")
        return corpus(argv[i + 1] if len(argv) > i + 1 else DEFAULT_CORPUS)
    if "--report" in argv:
        return report(show_retracted="--retracted" in argv)
    if "--retract" in argv:
        i = argv.index("--retract")
        if len(argv) <= i + 1:
            print("askscan --retract <packet.json>", file=sys.stderr)
            return 2
        try:
            out = retract(json.load(open(argv[i + 1], encoding="utf-8")))
        except ValueError as exc:
            print(f"askscan: {exc}", file=sys.stderr)
            return 1
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0

    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except Exception as exc:
        print(f"askscan: unreadable hook input: {exc}", file=sys.stderr)
        return 0

    if payload.get("stop_hook_active"):
        return 0

    import time
    g = gap(payload.get("last_assistant_message") or "", time.time())
    if g:
        # STAMPED WHERE IT IS TRUE, not where it is convenient. Only this path is a
        # real turn ending; a row without a source predates the stamp and cannot be
        # attributed, which is precisely the state the first 19 rows were in.
        g["source"] = "hook"
        where = record(g)
        if where:
            g["recorded_at"] = where
        # systemMessage ONLY. RULED: it does not need to stop the work.
        print(json.dumps({"systemMessage": receipt(g)}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:      # a scan must never be able to wedge a turn
        print(f"askscan failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(0)
